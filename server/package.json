{
  "name": "tradestratix-server",
  "version": "1.0.0",
  "description": "TradeStratix ERP API — Express + Prisma + MySQL",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "setup:db": "tsx scripts/setup-db.ts",
    "backfill:branches": "tsx scripts/backfill-branches.ts",
    "backfill:journal-entities": "tsx scripts/backfill-journal-entities.ts",
    "backfill:sales-rep-employees": "tsx scripts/backfill-sales-rep-employees.ts",
    "backfill:employee-users": "tsx scripts/backfill-employee-users.ts",
    "backfill:fulfilment": "tsx scripts/backfill-fulfilment-recognition.ts",
    "test:fulfilment": "tsx scripts/test-fulfilment.ts",
    "test:branches": "tsx scripts/test-multi-branch.ts",
    "test:journal-entities": "tsx scripts/test-journal-entities.ts",
    "test:sales-rep-employees": "tsx scripts/test-sales-rep-employees.ts",
    "reset:transactions": "tsx scripts/reset-transactions.ts",
    "db:reset": "npx prisma migrate reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

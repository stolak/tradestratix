generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── SaaS / Platform ─────────────────────────────────────────────────────────

model SubscriptionPlan {
  id            String                 @id
  code          String                 @unique
  name          String
  description   String?                @db.Text
  monthlyPrice  Decimal                @default(0) @map("monthly_price") @db.Decimal(18, 2)
  yearlyPrice   Decimal                @default(0) @map("yearly_price") @db.Decimal(18, 2)
  maxUsers      Int                    @default(5) @map("max_users")
  maxBranches   Int                    @default(1) @map("max_branches")
  maxWarehouses Int                    @default(2) @map("max_warehouses")
  modulesJson   String                 @map("modules_json") @db.Text
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  subscriptions BusinessSubscription[]

  @@map("subscription_plans")
}

model BusinessSubscription {
  id          String           @id
  businessId  String           @map("business_id")
  planId      String           @map("plan_id")
  status      String           @default("trial")
  startsAt    DateTime         @map("starts_at")
  endsAt      DateTime?        @map("ends_at")
  trialEndsAt DateTime?        @map("trial_ends_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([businessId])
  @@map("business_subscriptions")
}

// ─── Tenant / Organisation ───────────────────────────────────────────────────

model Business {
  id                   String   @id
  name                 String
  legalName            String?  @map("legal_name")
  registrationNumber   String?  @map("registration_number")
  taxId                String?  @map("tax_id")
  email                String?
  phone                String?
  addressLine1         String?  @map("address_line1")
  addressLine2         String?  @map("address_line2")
  city                 String?
  state                String?
  country              String?  @default("NG")
  postalCode           String?  @map("postal_code")
  logoUrl              String?  @map("logo_url") @db.Text
  /// distributor | wholesaler | retailer | distributor_retailer | hybrid
  businessType         String   @default("hybrid") @map("business_type")
  defaultCurrency      String   @default("NGN") @map("default_currency")
  /// fifo | weighted_average | specific_identification
  inventoryValuation   String   @default("weighted_average") @map("inventory_valuation")
  timezone             String   @default("Africa/Lagos")
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  enabledModulesJson   String?  @map("enabled_modules_json") @db.Text
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdById          String?  @map("created_by_id")
  updatedById          String?  @map("updated_by_id")

  settings                    BusinessSetting[]
  subscriptions               BusinessSubscription[]
  branches                    Branch[]
  warehouses                  Warehouse[]
  warehouseCategories         WarehouseCategory[]
  users                       User[]
  userBranches                UserBranch[]
  userWarehouses              UserWarehouse[]
  roles                       Role[]
  accounts                    Account[]
  journalEntries              JournalEntry[]
  defaultAccountSettings            DefaultAccountSetting[]
  defaultParentAccountSettings      DefaultParentAccountSetting[]
  financialYears                    FinancialYear[]
  accountingPeriods                 AccountingPeriod[]
  auditLogs                         AuditLog[]
  menus                             Menu[]
  currencies                        BusinessCurrency[]
  productCategories                 ProductCategory[]
  brands                            Brand[]
  productMakes                      ProductMake[]
  unitsOfMeasure                    UnitOfMeasure[]
  products                          Product[]
  productVariants                   ProductVariant[]
  stockLots                         StockLot[]
  stockSerials                      StockSerial[]
  stockMovements                    StockMovement[]
  stockTransfers                    StockTransfer[]
  productUnitConversions            ProductUnitConversion[]
  productSellingPrices              ProductSellingPrice[]
  branchSellingPrices               BranchSellingPrice[]
  branchProductDiscounts            BranchProductDiscount[]
  salesReservations                 SalesReservation[]
  salesFulfilments                  SalesFulfilment[]
  fulfilmentProofs                  FulfilmentProof[]
  pickupVerifications               PickupVerification[]
  salesReturns                      SalesReturn[]
  suppliers                         Supplier[]
  purchaseOrders                    PurchaseOrder[]
  goodsReceiptNotes                 GoodsReceiptNote[]
  supplierBills                     SupplierBill[]
  supplierPayments                  SupplierPayment[]
  customers                         Customer[]
  salesReps                         SalesRep[]
  salesInvoices                     SalesInvoice[]
  customerPayments                  CustomerPayment[]
  salesCommissions                  SalesCommission[]
  bankAccounts                      BankAccount[]
  bankTransactions                  BankTransaction[]
  expenseBills                      ExpenseBill[]
  expenseCategories                 ExpenseCategory[]
  fixedAssets                       FixedAsset[]
  depreciationEntries               DepreciationEntry[]
  assetCategories                   AssetCategory[]
  assetLocations                    AssetLocation[]
  assetAssignmentHistory            AssetAssignmentHistory[]
  assetStatusHistory                AssetStatusHistory[]
  assetDocuments                    AssetDocument[]
  assetAcquisitions                 AssetAcquisition[]
  assetCostAdditions                AssetCostAddition[]
  assetCapitalisations              AssetCapitalisation[]
  assetDepreciationBooks            AssetDepreciationBook[]
  assetDepreciationRuns             AssetDepreciationRun[]
  assetDepreciationRunLines         AssetDepreciationRunLine[]
  assetTransfers                    AssetTransfer[]
  assetTransferLines                AssetTransferLine[]
  assetMaintenanceRequests          AssetMaintenanceRequest[]
  assetMaintenanceWorkOrders        AssetMaintenanceWorkOrder[]
  assetMaintenanceCosts             AssetMaintenanceCost[]
  assetInsurances                   AssetInsurance[]
  assetInsuranceClaims              AssetInsuranceClaim[]
  assetWarranties                   AssetWarranty[]
  capitalProjects                   CapitalProject[]
  capitalProjectCosts               CapitalProjectCost[]
  assetComponents                   AssetComponent[]
  assetImpairments                  AssetImpairment[]
  assetRevaluations                 AssetRevaluation[]
  assetDisposals                    AssetDisposal[]
  assetAccountingEvents             AssetAccountingEvent[]
  assetVerificationCampaigns        AssetVerificationCampaign[]
  assetVerificationResults          AssetVerificationResult[]
  budgets                           Budget[]
  employees                         Employee[]
  attendanceRecords                 AttendanceRecord[]
  leaveRequests                     LeaveRequest[]
  payrollRuns                       PayrollRun[]
  salaryComponents                  SalaryComponent[]
  payGrades                         PayGrade[]
  salaryChartEntries                SalaryChartEntry[]
  employeePayPackageLines           EmployeePayPackageLine[]
  employeePayOverrides              EmployeePayOverride[]
  payrollStatutoryRules             PayrollStatutoryRule[]
  activePayrollPeriod               ActivePayrollPeriod?
  vehicles                          Vehicle[]
  deliveryOrders                    DeliveryOrder[]
  notifications                     AppNotification[]

  @@map("businesses")
}

model BusinessSetting {
  id         String   @id
  businessId String   @map("business_id")
  settingKey String   @map("setting_key")
  value      String   @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, settingKey])
  @@map("business_settings")
}

model BusinessCurrency {
  id           String   @id
  businessId   String   @map("business_id")
  code         String
  name         String
  symbol       String
  isDefault    Boolean  @default(false) @map("is_default")
  exchangeRate Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  isActive     Boolean  @default(true) @map("is_active")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@map("business_currencies")
}

model Branch {
  id                    String                  @id
  businessId            String                  @map("business_id")
  name                  String
  code                  String
  email                 String?
  phone                 String?
  addressLine1          String?                 @map("address_line1")
  city                  String?
  state                 String?
  country               String?
  managerUserId         String?                 @map("manager_user_id")
  operatingHours        String?                 @map("operating_hours") @db.Text
  salesTarget           Decimal?                @map("sales_target") @db.Decimal(18, 2)
  isActive              Boolean                 @default(true) @map("is_active")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  createdById           String?                 @map("created_by_id")
  updatedById           String?                 @map("updated_by_id")
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses            Warehouse[]
  userBranches          UserBranch[]
  usersDefault          User[]                  @relation("UserDefaultBranch")
  journalEntries        JournalEntry[]
  salesInvoices         SalesInvoice[]          @relation("InvoiceRevenueBranch")
  salesInvoicesSold     SalesInvoice[]          @relation("InvoiceSellingBranch")
  salesFulfilments      SalesFulfilment[]
  salesReturns          SalesReturn[]           @relation("ReturnReceivingBranch")
  salesReturnsRevenue   SalesReturn[]           @relation("ReturnRevenueBranch")
  fixedAssets           FixedAsset[]
  assetLocations        AssetLocation[]
  assetAcquisitions     AssetAcquisition[]
  assetTransfersFrom    AssetTransfer[] @relation("AssetTransferFromBranch")
  assetTransfersTo      AssetTransfer[] @relation("AssetTransferToBranch")
  capitalProjects       CapitalProject[]
  assetImpairments      AssetImpairment[]
  assetRevaluations     AssetRevaluation[]
  assetDisposals        AssetDisposal[]
  assetVerificationCampaigns AssetVerificationCampaign[]
  employees             Employee[]
  deliveryOrders        DeliveryOrder[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceiptNote[]
  supplierBills         SupplierBill[]
  supplierPayments      SupplierPayment[]
  customerPayments      CustomerPayment[]
  salesCommissions      SalesCommission[]
  expenseBills          ExpenseBill[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  stockMovements        StockMovement[]
  transfersFrom         StockTransfer[]         @relation("TransferFromBranch")
  transfersTo           StockTransfer[]         @relation("TransferToBranch")
  payrollRuns           PayrollRun[]
  budgets               Budget[]
  auditLogs             AuditLog[]
  sellingPriceOverrides BranchSellingPrice[]
  productDiscounts      BranchProductDiscount[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
  @@map("branches")
}

model WarehouseCategory {
  id                       String      @id
  businessId               String      @map("business_id")
  name                     String
  code                     String
  allowInterBranchTransfer Boolean     @default(true) @map("allow_inter_branch_transfer")
  allowInterBranchPickup   Boolean     @default(true) @map("allow_inter_branch_pickup")
  isActive                 Boolean     @default(true) @map("is_active")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")
  createdById              String?     @map("created_by_id")
  updatedById              String?     @map("updated_by_id")
  business                 Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses               Warehouse[]

  @@unique([businessId, code])
  @@unique([businessId, name])
  @@index([businessId])
  @@map("warehouse_categories")
}

model Warehouse {
  id                String             @id
  businessId        String             @map("business_id")
  branchId          String             @map("branch_id")
  name              String
  code              String
  /// Denormalized category code (kept for display / legacy); prefer categoryId
  category          String             @default("main")
  categoryId        String?            @map("category_id")
  managerUserId     String?            @map("manager_user_id")
  capacity          Decimal?           @db.Decimal(18, 2)
  addressLine1      String?            @map("address_line1")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  createdById       String?            @map("created_by_id")
  updatedById       String?            @map("updated_by_id")
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouseCategory WarehouseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stockLots         StockLot[]
  stockSerials      StockSerial[]
  stockMovements    StockMovement[]
  transfersFrom     StockTransfer[]    @relation("TransferFrom")
  transfersTo       StockTransfer[]    @relation("TransferTo")
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceiptNote[]
  salesInvoices     SalesInvoice[]
  deliveryOrders    DeliveryOrder[]
  userWarehouses    UserWarehouse[]
  fulfilmentLines   SalesInvoiceItem[]
  salesReservations SalesReservation[]
  salesFulfilments  SalesFulfilment[]
  salesReturns      SalesReturn[]
  fixedAssets       FixedAsset[]

  @@unique([businessId, code])
  @@index([branchId])
  @@index([categoryId])
  @@map("warehouses")
}

// ─── Identity & RBAC ─────────────────────────────────────────────────────────

model User {
  id              String    @id
  businessId      String    @map("business_id")
  username        String
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name")
  /// Primary role code for JWT convenience
  role            String
  email           String?
  phone           String?
  department      String?
  avatarUrl       String?   @map("avatar_url") @db.Text
  defaultBranchId String?   @map("default_branch_id")
  status          String    @default("active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdById     String?   @map("created_by_id")
  updatedById     String?   @map("updated_by_id")

  business            Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultBranch       Branch?                  @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  userBranches        UserBranch[]
  userWarehouses      UserWarehouse[]
  loginHistory        LoginHistory[]
  refreshTokens       RefreshToken[]
  employees           Employee[]
  notifications       AppNotification[]

  @@unique([businessId, username])
  @@index([businessId])
  @@map("users")
}

model Role {
  id              String           @id
  businessId      String?          @map("business_id")
  code            String
  name            String
  description     String?          @db.Text
  isSystem        Boolean          @default(false) @map("is_system")
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  roleMenus       RoleMenu[]

  @@unique([businessId, code])
  @@map("roles")
}

model Permission {
  id              String                   @id
  code            String                   @unique
  name            String
  description     String?                  @db.Text
  module          String
  action          String
  isActive        Boolean                  @default(true) @map("is_active")
  sortOrder       Int                      @default(0) @map("sort_order")
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model Menu {
  id         String     @id
  businessId String?    @map("business_id")
  code       String
  name       String
  route      String?
  icon       String?
  section    String?
  parentId   String?    @map("parent_id")
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  business   Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Menu[]     @relation("MenuTree")
  roleMenus  RoleMenu[]

  @@unique([businessId, code])
  @@map("menus")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleMenu {
  roleId String @map("role_id")
  menuId String @map("menu_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}

model UserPermissionOverride {
  id           String     @id
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  /// grant | deny
  effect       String
  createdById  String?    @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model UserBranch {
  userId       String   @map("user_id")
  businessId   String   @map("business_id")
  branchId     String   @map("branch_id")
  /// Optional branch-specific role code (e.g. sales_manager)
  roleCode     String?  @map("role_code")
  /// active | revoked
  status       String   @default("active")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([businessId, userId])
  @@index([branchId, status])
  @@map("user_branches")
}

model UserWarehouse {
  userId       String    @map("user_id")
  businessId   String    @map("business_id")
  warehouseId  String    @map("warehouse_id")
  /// active | revoked
  status       String    @default("active")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedById String?   @map("assigned_by_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([businessId, userId])
  @@index([warehouseId, status])
  @@map("user_warehouses")
}

model LoginHistory {
  id        String   @id
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_history")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Accounting ──────────────────────────────────────────────────────────────

model Account {
  id                          String                       @id
  businessId                  String                       @map("business_id")
  code                        String
  name                        String
  /// asset | liability | equity | revenue | expense | cogs
  accountType                 String                       @map("account_type")
  parentId                    String?                      @map("parent_id")
  isActive                    Boolean                      @default(true) @map("is_active")
  isSystem                    Boolean                      @default(false) @map("is_system")
  description                 String?                      @db.Text
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  business                    Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent                      Account?                     @relation("AccountTree", fields: [parentId], references: [id])
  children                    Account[]                    @relation("AccountTree")
  journalLines                JournalLine[]
  defaultSettings                DefaultAccountSetting[]
  defaultParentAccountSettings   DefaultParentAccountSetting[]
  supplierPayments               SupplierPayment[]
  customerPayments               CustomerPayment[]
  bankAccounts                   BankAccount[]
  bankTxnOffsets                 BankTransaction[]            @relation("BankTxnOffsetAccount")
  expenseLines                   ExpenseBillLine[]
  expenseCategories              ExpenseCategory[]
  expenseFundingBills            ExpenseBill[]               @relation("ExpenseFundingAccount")
  budgetLines                    BudgetLine[]
  assetCategoriesCost            AssetCategory[]             @relation("AssetCategoryCostAccount")
  assetCategoriesAccumDep        AssetCategory[]             @relation("AssetCategoryAccumDepAccount")
  assetCategoriesDepExpense      AssetCategory[]             @relation("AssetCategoryDepExpenseAccount")
  assetCategoriesImpairment      AssetCategory[]             @relation("AssetCategoryImpairmentAccount")
  assetCategoriesDisposalGain    AssetCategory[]             @relation("AssetCategoryDisposalGainAccount")
  assetCategoriesDisposalLoss    AssetCategory[]             @relation("AssetCategoryDisposalLossAccount")
  assetCategoriesCip             AssetCategory[]             @relation("AssetCategoryCipAccount")
  fixedAssetsCostAccount         FixedAsset[]                @relation("FixedAssetCostAccount")
  fixedAssetsAccumDepAccount     FixedAsset[]                @relation("FixedAssetAccumDepAccount")
  fixedAssetsDepExpenseAccount   FixedAsset[]                @relation("FixedAssetDepExpenseAccount")
  salaryComponents               SalaryComponent[]           @relation("SalaryComponentAccount")

  @@unique([businessId, code])
  @@index([businessId])
  @@map("accounts")
}

model JournalEntry {
  id                    String         @id
  businessId            String         @map("business_id")
  branchId              String?        @map("branch_id")
  /// Primary customer for AR / customer-facing journals (nullable)
  customerId            String?        @map("customer_id")
  /// Primary supplier for AP / supplier-facing journals (nullable)
  supplierId            String?        @map("supplier_id")
  /// Commercial sales representative responsible (not the posting user)
  salesRepresentativeId String?        @map("sales_representative_id")
  entryNumber           String         @map("entry_number")
  /// Date the journal was entered / booked in the system (posting day)
  entryDate             DateTime       @map("entry_date")
  /// Economic / business date of the transaction (may be backdated; never in the future)
  transactionDate       DateTime       @map("transaction_date")
  memo                  String?        @db.Text
  /// draft | posted | reversed
  status                String         @default("draft")
  sourceType            String?        @map("source_type")
  sourceId              String?        @map("source_id")
  idempotencyKey        String?        @map("idempotency_key")
  currencyCode          String         @default("NGN") @map("currency_code")
  postedAt              DateTime?      @map("posted_at")
  postedById            String?        @map("posted_by_id")
  reversedByEntryId     String?        @map("reversed_by_entry_id")
  createdById           String?        @map("created_by_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer              Customer?      @relation("JournalCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  supplier              Supplier?      @relation("JournalSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  salesRepresentative   SalesRep?      @relation("JournalSalesRep", fields: [salesRepresentativeId], references: [id], onDelete: Restrict)
  lines                 JournalLine[]
  reversedBy            JournalEntry?  @relation("JournalReversal", fields: [reversedByEntryId], references: [id])
  reverses              JournalEntry[] @relation("JournalReversal")

  @@unique([businessId, entryNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, sourceType, sourceId])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@index([businessId, salesRepresentativeId])
  @@index([entryDate])
  @@index([transactionDate])
  @@map("journal_entries")
}

model JournalLine {
  id                    String       @id
  journalEntryId        String       @map("journal_entry_id")
  accountId             String       @map("account_id")
  description           String?      @db.Text
  debit                 Decimal      @default(0) @db.Decimal(18, 4)
  credit                Decimal      @default(0) @db.Decimal(18, 4)
  lineNo                Int          @map("line_no")
  /// Business/transaction date for the line (normally mirrors the parent journal entry_date)
  transactionDate       DateTime     @map("transaction_date")
  /// Set only on customer control lines (typically AR) — partner balances use this, not the current default-account map
  customerId            String?      @map("customer_id")
  /// Set only on supplier control lines (typically AP)
  supplierId            String?      @map("supplier_id")
  /// Set only on sales-rep control lines (custody / commission payable / recoveries)
  salesRepresentativeId String?      @map("sales_representative_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  journalEntry          JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account               Account      @relation(fields: [accountId], references: [id])
  customer              Customer?    @relation("JournalLineCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  supplier              Supplier?    @relation("JournalLineSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  salesRepresentative   SalesRep?    @relation("JournalLineSalesRep", fields: [salesRepresentativeId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
  @@index([salesRepresentativeId])
  @@index([transactionDate])
  @@map("journal_lines")
}

model DefaultAccountSetting {
  id          String   @id
  businessId  String   @map("business_id")
  settingKey  String   @map("setting_key")
  accountId   String   @map("account_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id])
  description String?  @map("description")

  @@unique([businessId, settingKey])
  @@map("default_account_settings")
}

/// Maps an operation key to a CoA parent so ledger pickers can filter to that subtree.
model DefaultParentAccountSetting {
  id              String   @id
  businessId      String   @map("business_id")
  settingKey      String   @map("setting_key")
  parentAccountId String   @map("parent_account_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentAccount   Account  @relation(fields: [parentAccountId], references: [id])
  description     String?  @map("description")

  @@unique([businessId, settingKey])
  @@map("default_parent_account_settings")
}

model FinancialYear {
  id         String             @id
  businessId String             @map("business_id")
  name       String
  startsOn   DateTime           @map("starts_on")
  endsOn     DateTime           @map("ends_on")
  isClosed   Boolean            @default(false) @map("is_closed")
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periods    AccountingPeriod[]

  @@index([businessId])
  @@map("financial_years")
}

model AccountingPeriod {
  id              String        @id
  businessId      String        @map("business_id")
  financialYearId String        @map("financial_year_id")
  name            String
  periodNo        Int           @map("period_no")
  startsOn        DateTime      @map("starts_on")
  endsOn          DateTime      @map("ends_on")
  isLocked        Boolean       @default(false) @map("is_locked")
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@unique([financialYearId, periodNo])
  @@map("accounting_periods")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id         String    @id
  businessId String?   @map("business_id")
  branchId   String?   @map("branch_id")
  userId     String?   @map("user_id")
  action     String
  module     String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  summary    String?   @db.Text
  /// Field-level diff for updates: { field: { from, to }, ... }
  changes    String?   @db.LongText
  metadata   String?   @db.LongText
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@index([module])
  @@map("audit_logs")
}

// ─── Phase 2: Products & Inventory ───────────────────────────────────────────

model ProductCategory {
  id          String            @id
  businessId  String            @map("business_id")
  parentId    String?           @map("parent_id")
  name        String
  code        String?
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("product_categories")
}

model Brand {
  id          String    @id
  businessId  String    @map("business_id")
  name        String
  code        String?
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("brands")
}

/// Product make / marque (e.g. appliance line under a brand). Optional on products.
model ProductMake {
  id          String    @id
  businessId  String    @map("business_id")
  name        String
  code        String?
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("product_makes")
}

model UnitOfMeasure {
  id                 String                  @id
  businessId         String                  @map("business_id")
  code               String
  name               String
  /// Count | Volume | Weight | Length | Packaging
  unitCategory       String                  @default("Count") @map("unit_category")
  allowsDecimal      Boolean                 @default(false) @map("allows_decimal")
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productsBase       Product[]               @relation("ProductBaseUom")
  productsPurchase   Product[]               @relation("ProductPurchaseUom")
  productsSelling    Product[]               @relation("ProductSellingUom")
  conversionsFrom    ProductUnitConversion[] @relation("ConversionFrom")
  conversionsTo      ProductUnitConversion[] @relation("ConversionTo")
  stockMovements     StockMovement[]
  sellingPrices      ProductSellingPrice[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesInvoiceItems  SalesInvoiceItem[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("units_of_measure")
}

model Product {
  id                  String   @id
  businessId          String   @map("business_id")
  name                String
  productCode         String?  @map("product_code")
  sku                 String?
  barcode             String?
  description         String?  @db.Text
  categoryId          String?  @map("category_id")
  brandId             String?  @map("brand_id")
  makeId              String?  @map("make_id")
  manufacturer        String?
  imageUrl            String?  @map("image_url") @db.Text
  status              String   @default("active")
  /// Derived summary of enabled tracking flags (e.g. expiry+batch+weight)
  trackingMode        String   @default("standard") @map("tracking_mode")
  trackBatch          Boolean  @default(false) @map("track_batch")
  trackExpiry         Boolean  @default(false) @map("track_expiry")
  trackSerial         Boolean  @default(false) @map("track_serial")
  trackWeight         Boolean  @default(false) @map("track_weight")
  trackLength         Boolean  @default(false) @map("track_length")
  hasVariants         Boolean  @default(false) @map("has_variants")
  baseUomId           String   @map("base_uom_id")
  purchaseUomId       String?  @map("purchase_uom_id")
  sellingUomId        String?  @map("selling_uom_id")
  reorderLevel        Decimal  @default(0) @map("reorder_level") @db.Decimal(18, 4)
  minStock            Decimal  @default(0) @map("min_stock") @db.Decimal(18, 4)
  maxStock            Decimal? @map("max_stock") @db.Decimal(18, 4)
  defaultPurchaseCost Decimal  @default(0) @map("default_purchase_cost") @db.Decimal(18, 4)
  defaultSellingPrice Decimal  @default(0) @map("default_selling_price") @db.Decimal(18, 4)
  distributorPrice    Decimal? @map("distributor_price") @db.Decimal(18, 4)
  wholesalePrice      Decimal? @map("wholesale_price") @db.Decimal(18, 4)
  retailPrice         Decimal? @map("retail_price") @db.Decimal(18, 4)
  taxCategory         String?  @map("tax_category")
  /// Output VAT percent for sales (e.g. 7.5). Snapshotted onto invoice lines at sale time.
  vatRate             Decimal  @default(0) @map("vat_rate") @db.Decimal(8, 4)
  expiryAlertDaysJson String?  @map("expiry_alert_days_json") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdById         String?  @map("created_by_id")
  updatedById         String?  @map("updated_by_id")

  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  make               ProductMake?            @relation(fields: [makeId], references: [id], onDelete: SetNull)
  baseUom            UnitOfMeasure           @relation("ProductBaseUom", fields: [baseUomId], references: [id])
  purchaseUom        UnitOfMeasure?          @relation("ProductPurchaseUom", fields: [purchaseUomId], references: [id])
  sellingUom         UnitOfMeasure?          @relation("ProductSellingUom", fields: [sellingUomId], references: [id])
  variants           ProductVariant[]
  conversions        ProductUnitConversion[]
  sellingPrices      ProductSellingPrice[]
  branchDiscounts    BranchProductDiscount[]
  stockLots          StockLot[]
  stockSerials       StockSerial[]
  stockMovements     StockMovement[]
  transferItems      StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesInvoiceItems  SalesInvoiceItem[]
  deliveryItems      DeliveryOrderItem[]

  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([status])
  @@map("products")
}

/// Selling price per configured product UoM (base or packaging conversion unit).
model ProductSellingPrice {
  id              String               @id
  businessId      String               @map("business_id")
  productId       String               @map("product_id")
  uomId           String               @map("uom_id")
  /// retail | wholesale | distributor | special | custom
  priceLevel      String               @default("retail") @map("price_level")
  label           String?
  unitPrice       Decimal              @map("unit_price") @db.Decimal(18, 4)
  minQty          Decimal              @default(1) @map("min_qty") @db.Decimal(18, 4)
  isDefault       Boolean              @default(false) @map("is_default")
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom             UnitOfMeasure        @relation(fields: [uomId], references: [id])
  branchOverrides BranchSellingPrice[]

  @@unique([productId, uomId, priceLevel])
  @@index([productId])
  @@map("product_selling_prices")
}

/// Branch-specific override of a global ProductSellingPrice row.
/// When absent (or inactive) the branch sells at the global price.
model BranchSellingPrice {
  id             String              @id
  businessId     String              @map("business_id")
  branchId       String              @map("branch_id")
  sellingPriceId String              @map("selling_price_id")
  unitPrice      Decimal             @map("unit_price") @db.Decimal(18, 4)
  isActive       Boolean             @default(true) @map("is_active")
  createdById    String?             @map("created_by_id")
  updatedById    String?             @map("updated_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sellingPrice   ProductSellingPrice @relation(fields: [sellingPriceId], references: [id], onDelete: Cascade)

  @@unique([branchId, sellingPriceId])
  @@index([businessId, branchId])
  @@map("branch_selling_prices")
}

/// Branch-specific % discount on a product, applied to every UoM / price level
/// after any branch price override.
model BranchProductDiscount {
  id              String   @id
  businessId      String   @map("business_id")
  branchId        String   @map("branch_id")
  productId       String   @map("product_id")
  discountPercent Decimal  @map("discount_percent") @db.Decimal(8, 4)
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String?  @map("created_by_id")
  updatedById     String?  @map("updated_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([businessId, branchId])
  @@map("branch_product_discounts")
}

model ProductVariant {
  id                 String              @id
  businessId         String              @map("business_id")
  productId          String              @map("product_id")
  name               String
  sku                String?
  barcode            String?
  size               String?
  colour             String?
  attributesJson     String?             @map("attributes_json") @db.Text
  purchaseCost       Decimal?            @map("purchase_cost") @db.Decimal(18, 4)
  sellingPrice       Decimal?            @map("selling_price") @db.Decimal(18, 4)
  isDefault          Boolean             @default(false) @map("is_default")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLots          StockLot[]
  stockSerials       StockSerial[]
  stockMovements     StockMovement[]
  transferItems      StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesInvoiceItems  SalesInvoiceItem[]
  deliveryItems      DeliveryOrderItem[]

  @@unique([businessId, sku])
  @@index([productId])
  @@map("product_variants")
}

/// Conversion into base UoM: 1 fromUom = factor base units (via chain if needed).
model ProductUnitConversion {
  id         String        @id
  businessId String        @map("business_id")
  productId  String        @map("product_id")
  fromUomId  String        @map("from_uom_id")
  toUomId    String        @map("to_uom_id")
  factor     Decimal       @db.Decimal(18, 6)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUom    UnitOfMeasure @relation("ConversionFrom", fields: [fromUomId], references: [id])
  toUom      UnitOfMeasure @relation("ConversionTo", fields: [toUomId], references: [id])

  @@unique([productId, fromUomId, toUomId])
  @@map("product_unit_conversions")
}

model StockLot {
  id                String              @id
  businessId        String              @map("business_id")
  productId         String              @map("product_id")
  variantId         String              @map("variant_id")
  warehouseId       String              @map("warehouse_id")
  lotKey            String              @map("lot_key")
  batchNumber       String              @default("BULK") @map("batch_number")
  manufacturingDate String?             @map("manufacturing_date")
  expiryDate        String?             @map("expiry_date")
  quantityOnHand    Decimal             @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  quantityReserved  Decimal             @default(0) @map("quantity_reserved") @db.Decimal(18, 4)
  quantityInTransit Decimal             @default(0) @map("quantity_in_transit") @db.Decimal(18, 4)
  unitCost          Decimal?            @map("unit_cost") @db.Decimal(18, 4)
  /// available | quarantine | recalled | expired
  status            String              @default("available")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id])
  variant           ProductVariant      @relation(fields: [variantId], references: [id])
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  movements         StockMovement[]
  transferItems     StockTransferItem[]
  salesReservations SalesReservation[]
  serials           StockSerial[]

  @@unique([businessId, lotKey])
  @@index([variantId, warehouseId])
  @@index([expiryDate])
  @@map("stock_lots")
}

/// One physical unit for products with trackSerial. Qty is always 1.
model StockSerial {
  id                  String    @id
  businessId          String    @map("business_id")
  productId           String    @map("product_id")
  variantId           String    @map("variant_id")
  warehouseId         String    @map("warehouse_id")
  lotId               String?   @map("lot_id")
  serialNumber        String    @map("serial_number")
  /// available | reserved | in_transit | sold | written_off | quarantine
  status              String    @default("available")
  unitCost            Decimal?  @map("unit_cost") @db.Decimal(18, 4)
  reservationId       String?   @map("reservation_id")
  /// sales_invoice | stock_transfer | sales_return | …
  issuedReferenceType String?   @map("issued_reference_type")
  issuedReferenceId   String?   @map("issued_reference_id")
  receivedAt          DateTime? @map("received_at")
  issuedAt            DateTime? @map("issued_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id])
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  lot         StockLot?         @relation(fields: [lotId], references: [id], onDelete: SetNull)
  reservation SalesReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([businessId, productId, serialNumber])
  @@index([variantId, warehouseId, status])
  @@index([lotId, status])
  @@index([reservationId])
  @@index([issuedReferenceType, issuedReferenceId])
  @@map("stock_serials")
}

model StockMovement {
  id                  String         @id
  businessId          String         @map("business_id")
  branchId            String?        @map("branch_id")
  productId           String         @map("product_id")
  variantId           String         @map("variant_id")
  warehouseId         String         @map("warehouse_id")
  lotId               String?        @map("lot_id")
  /// receive | issue | adjust_in | adjust_out | transfer_out | transfer_in | opening | write_off | return_in | return_out
  movementType        String         @map("movement_type")
  quantityIn          Decimal        @default(0) @map("quantity_in") @db.Decimal(18, 4)
  quantityOut         Decimal        @default(0) @map("quantity_out") @db.Decimal(18, 4)
  transactionQuantity Decimal?       @map("transaction_quantity") @db.Decimal(18, 4)
  transactionUomId    String?        @map("transaction_uom_id")
  unitCost            Decimal?       @map("unit_cost") @db.Decimal(18, 4)
  totalCost           Decimal?       @map("total_cost") @db.Decimal(18, 4)
  referenceType       String?        @map("reference_type")
  referenceId         String?        @map("reference_id")
  batchNumber         String?        @map("batch_number")
  expiryDate          String?        @map("expiry_date")
  reason              String?        @db.Text
  performedById       String?        @map("performed_by_id")
  performedByName     String?        @map("performed_by_name")
  idempotencyKey      String?        @map("idempotency_key")
  status              String         @default("completed")
  createdAt           DateTime       @default(now()) @map("created_at")
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product             Product        @relation(fields: [productId], references: [id])
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  warehouse           Warehouse      @relation(fields: [warehouseId], references: [id])
  lot                 StockLot?      @relation(fields: [lotId], references: [id])
  transactionUom      UnitOfMeasure? @relation(fields: [transactionUomId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([productId, createdAt])
  @@index([warehouseId])
  @@index([branchId])
  @@index([lotId])
  @@map("stock_movements")
}

model StockTransfer {
  id              String              @id
  businessId      String              @map("business_id")
  transferNumber  String              @map("transfer_number")
  fromWarehouseId String              @map("from_warehouse_id")
  toWarehouseId   String              @map("to_warehouse_id")
  fromBranchId    String?             @map("from_branch_id")
  toBranchId      String?             @map("to_branch_id")
  /// draft | pending_approval | approved | in_transit | received | rejected | cancelled
  /// New sends go straight to in_transit (qty held on source until receive).
  status          String              @default("draft")
  notes           String?             @db.Text
  requestedById   String?             @map("requested_by_id")
  approvedById    String?             @map("approved_by_id")
  receivedById    String?             @map("received_by_id")
  dispatchedAt    DateTime?           @map("dispatched_at")
  receivedAt      DateTime?           @map("received_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  fromBranch      Branch?             @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch        Branch?             @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)
  items           StockTransferItem[]

  @@unique([businessId, transferNumber])
  @@index([status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String         @id
  transferId        String         @map("transfer_id")
  productId         String         @map("product_id")
  variantId         String         @map("variant_id")
  fromLotId         String?        @map("from_lot_id")
  quantity          Decimal        @db.Decimal(18, 4)
  batchNumber       String?        @map("batch_number")
  expiryDate        String?        @map("expiry_date")
  /// JSON string array of serial numbers held/moved on this line
  serialNumbersJson String?        @map("serial_numbers_json") @db.Text
  outMovementId     String?        @map("out_movement_id")
  inMovementId      String?        @map("in_movement_id")
  transfer          StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id])
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  fromLot           StockLot?      @relation(fields: [fromLotId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ─── Phase 3: Suppliers / Procurement / AP ───────────────────────────────────

model Supplier {
  id               String   @id
  businessId       String   @map("business_id")
  code             String?
  name             String
  contactPerson    String?  @map("contact_person")
  email            String?
  phone            String?
  addressLine1     String?  @map("address_line1")
  city             String?
  state            String?
  country          String?  @default("NG")
  taxId            String?  @map("tax_id")
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(18, 2)
  notes            String?  @db.Text
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdById      String?  @map("created_by_id")
  updatedById      String?  @map("updated_by_id")

  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fixedAssets      FixedAsset[]
  assetAcquisitions AssetAcquisition[]
  purchaseOrders   PurchaseOrder[]
  receipts         GoodsReceiptNote[]
  bills            SupplierBill[]
  payments         SupplierPayment[]
  expenseBills     ExpenseBill[]
  journalEntries   JournalEntry[]     @relation("JournalSupplier")
  journalLines     JournalLine[]      @relation("JournalLineSupplier")

  @@unique([businessId, code])
  @@index([businessId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id
  businessId   String    @map("business_id")
  branchId     String?   @map("branch_id")
  supplierId   String    @map("supplier_id")
  warehouseId  String    @map("warehouse_id")
  poNumber     String    @map("po_number")
  /// draft | pending_approval | approved | partially_received | received | cancelled
  status       String    @default("draft")
  orderDate    DateTime  @default(now()) @map("order_date")
  expectedDate DateTime? @map("expected_date")
  notes        String?   @db.Text
  subtotal     Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount    Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]
  receipts  GoodsReceiptNote[]

  @@unique([businessId, poNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id
  purchaseOrderId  String  @map("purchase_order_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  uomId            String? @map("uom_id")
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(18, 4)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(18, 4)
  unitCost         Decimal @map("unit_cost") @db.Decimal(18, 4)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 4)
  notes            String? @db.Text

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id])
  variant       ProductVariant?    @relation(fields: [variantId], references: [id])
  uom           UnitOfMeasure?     @relation(fields: [uomId], references: [id])
  receiptItems  GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceiptNote {
  id              String   @id
  businessId      String   @map("business_id")
  branchId        String?  @map("branch_id")
  supplierId      String   @map("supplier_id")
  purchaseOrderId String?  @map("purchase_order_id")
  warehouseId     String   @map("warehouse_id")
  grnNumber       String   @map("grn_number")
  /// draft | posted | cancelled
  status          String   @default("draft")
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?  @db.Text
  subtotal        Decimal  @default(0) @db.Decimal(18, 4)
  journalEntryId  String?  @map("journal_entry_id")
  billId          String?  @map("bill_id")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  items         GoodsReceiptItem[]
  bill          SupplierBill?

  @@unique([businessId, grnNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@map("goods_receipt_notes")
}

model GoodsReceiptItem {
  id                  String  @id
  grnId               String  @map("grn_id")
  purchaseOrderItemId String? @map("purchase_order_item_id")
  productId           String  @map("product_id")
  variantId           String? @map("variant_id")
  uomId               String? @map("uom_id")
  quantity            Decimal @db.Decimal(18, 4)
  unitCost            Decimal @map("unit_cost") @db.Decimal(18, 4)
  lineTotal           Decimal @map("line_total") @db.Decimal(18, 4)
  batchNumber         String? @map("batch_number")
  expiryDate          String? @map("expiry_date")
  manufacturingDate   String? @map("manufacturing_date")
  /// JSON string array of serial numbers received on this line
  serialNumbersJson   String? @map("serial_numbers_json") @db.Text
  stockMovementId     String? @map("stock_movement_id")

  grn               GoodsReceiptNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  variant           ProductVariant?    @relation(fields: [variantId], references: [id])
  uom               UnitOfMeasure?     @relation(fields: [uomId], references: [id])

  @@index([grnId])
  @@map("goods_receipt_items")
}

model SupplierBill {
  id             String    @id
  businessId     String    @map("business_id")
  branchId       String?   @map("branch_id")
  supplierId     String    @map("supplier_id")
  grnId          String?   @unique @map("grn_id")
  billNumber     String    @map("bill_number")
  billDate       DateTime  @default(now()) @map("bill_date")
  dueDate        DateTime? @map("due_date")
  /// open | partial | paid | void
  status         String    @default("open")
  subtotal       Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 4)
  balance        Decimal   @default(0) @db.Decimal(18, 4)
  journalEntryId String?   @map("journal_entry_id")
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  grn         GoodsReceiptNote?           @relation(fields: [grnId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([businessId, billNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@index([supplierId])
  @@map("supplier_bills")
}

model SupplierPayment {
  id              String   @id
  businessId      String   @map("business_id")
  branchId        String?  @map("branch_id")
  supplierId      String   @map("supplier_id")
  paymentNumber   String   @map("payment_number")
  paymentDate     DateTime @default(now()) @map("payment_date")
  amount          Decimal  @db.Decimal(18, 4)
  /// cash | bank | transfer | cheque | other
  method          String   @default("bank")
  accountId       String?  @map("account_id")
  reference       String?
  notes           String?  @db.Text
  journalEntryId  String?  @map("journal_entry_id")
  /// Advance / overpay still available to apply to later bills (GL lives on supplier AP)
  unappliedAmount Decimal  @default(0) @map("unapplied_amount") @db.Decimal(18, 4)
  idempotencyKey  String?  @map("idempotency_key")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  account     Account?                    @relation(fields: [accountId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([businessId, paymentNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, supplierId])
  @@index([branchId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id        String  @id
  paymentId String  @map("payment_id")
  billId    String  @map("bill_id")
  amount    Decimal @db.Decimal(18, 4)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId], references: [id])

  @@index([paymentId])
  @@index([billId])
  @@map("supplier_payment_allocations")
}

// ─── Phase 4: Customers / Sales / POS / Reps ─────────────────────────────────

model Customer {
  id               String   @id
  businessId       String   @map("business_id")
  code             String?
  name             String
  contactPerson    String?  @map("contact_person")
  email            String?
  phone            String?
  addressLine1     String?  @map("address_line1")
  city             String?
  state            String?
  country          String?  @default("NG")
  taxId            String?  @map("tax_id")
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  /// null = unlimited credit; 0 = cash only
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(18, 2)
  /// Invoice-level discount applied to every purchase (null/0 = none)
  discountPercent  Decimal? @map("discount_percent") @db.Decimal(8, 4)
  /// retail | wholesale | distributor | walk_in
  customerType     String   @default("retail") @map("customer_type")
  notes            String?  @db.Text
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdById      String?  @map("created_by_id")
  updatedById      String?  @map("updated_by_id")

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  noteRows       CustomerNote[]
  invoices       SalesInvoice[]
  payments       CustomerPayment[]
  deliveries     DeliveryOrder[]
  salesReturns   SalesReturn[]
  journalEntries JournalEntry[]    @relation("JournalCustomer")
  journalLines   JournalLine[]     @relation("JournalLineCustomer")

  @@unique([businessId, code])
  @@index([businessId, name])
  @@map("customers")
}

model CustomerNote {
  id          String   @id
  businessId  String   @map("business_id")
  customerId  String   @map("customer_id")
  body        String   @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_notes")
}

/// Commercial sales-rep profile only (commission / attribution).
/// Identity (name/phone/email), home branch, and login live on Employee (+ User).
/// Journal/sales attribution uses SalesRep.id; transaction branch comes from active session (X-Branch-Id), not employee.home branch.
model SalesRep {
  id                String   @id
  businessId        String   @map("business_id")
  /// HR employee this sales-rep role belongs to (1:1). Employee must exist first.
  employeeId        String   @unique @map("employee_id")
  code              String?
  commissionPercent Decimal  @default(0) @map("commission_percent") @db.Decimal(8, 4)
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdById       String?  @map("created_by_id")

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  invoices       SalesInvoice[]
  commissions    SalesCommission[]
  journalEntries JournalEntry[]    @relation("JournalSalesRep")
  journalLines   JournalLine[]     @relation("JournalLineSalesRep")

  @@unique([businessId, code])
  @@index([businessId, employeeId])
  @@map("sales_reps")
}

model SalesInvoice {
  id                   String    @id
  businessId           String    @map("business_id")
  customerId           String    @map("customer_id")
  /// Preferred fulfilment warehouse; null on open pickup = collect at any branch with stock
  warehouseId          String?   @map("warehouse_id")
  /// Revenue branch: AR, revenue and COGS are booked here
  branchId             String?   @map("branch_id")
  /// Branch where the sale was made (pricing, rep, discounts); defaults to branchId
  sellingBranchId      String?   @map("selling_branch_id")
  salesRepId           String?   @map("sales_rep_id")
  invoiceNumber        String    @map("invoice_number")
  /// sales | pos
  channel              String    @default("sales")
  /// draft | posted | void
  status               String    @default("draft")
  /// immediate (handed over at confirmation) | pickup (collected later) | delivery (delivered to the customer)
  fulfilmentMode       String    @default("immediate") @map("fulfilment_mode")
  /// pending | partial | fulfilled
  fulfilmentStatus     String    @default("fulfilled") @map("fulfilment_status")
  /// at_fulfilment: revenue/AR per hand-over | on_posting: legacy, revenue booked when posted
  recognitionPolicy    String    @default("at_fulfilment") @map("recognition_policy")
  /// Revenue + tax recognised so far (the receivable raised)
  recognisedAmount     Decimal   @default(0) @map("recognised_amount") @db.Decimal(18, 4)
  /// Payments received but not yet applied to recognised value (customer deposit liability)
  depositHeld          Decimal   @default(0) @map("deposit_held") @db.Decimal(18, 4)
  /// Order value released by cancellation (never recognised)
  cancelledAmount      Decimal   @default(0) @map("cancelled_amount") @db.Decimal(18, 4)
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  cancelledAt          DateTime? @map("cancelled_at")
  cancelledById        String?   @map("cancelled_by_id")
  cancelReason         String?   @map("cancel_reason") @db.Text
  /// Credit limit override recorded at confirmation
  creditOverrideById   String?   @map("credit_override_by_id")
  creditOverrideReason String?   @map("credit_override_reason") @db.Text
  /// Code the customer quotes at collection (pickup orders); never shown on warehouse screens
  pickupCode           String?   @map("pickup_code")
  pickupCodeIssuedAt   DateTime? @map("pickup_code_issued_at")
  pickupCodeExpiresAt  DateTime? @map("pickup_code_expires_at")
  /// Consecutive failed code entries; the code locks at 5 until reissued
  pickupCodeFailures   Int       @default(0) @map("pickup_code_failures")
  /// People besides the customer allowed to collect: [{ name, phone }]
  authorisedCollectors Json?     @map("authorised_collectors")
  /// Delivery orders: where the goods go
  deliveryAddress      String?   @map("delivery_address") @db.Text
  deliveryContact      String?   @map("delivery_contact")
  deliveryPhone        String?   @map("delivery_phone")
  /// open | partial | paid | void
  paymentStatus        String    @default("open") @map("payment_status")
  invoiceDate          DateTime  @default(now()) @map("invoice_date")
  dueDate              DateTime? @map("due_date")
  notes                String?   @db.Text
  subtotal             Decimal   @default(0) @db.Decimal(18, 4)
  /// Sum of item-level discounts (list − net before special discount)
  itemDiscountTotal    Decimal   @default(0) @map("item_discount_total") @db.Decimal(18, 4)
  /// percentage | fixed — invoice-level / special discount (after item discounts, before VAT)
  discountType         String?   @map("discount_type")
  /// Special discount % when discountType = percentage
  discountPercent      Decimal?  @map("discount_percent") @db.Decimal(8, 4)
  /// Special discount amount (computed or fixed), allocated across lines before VAT
  discountAmount       Decimal   @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  amountPaid           Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 4)
  balance              Decimal   @default(0) @db.Decimal(18, 4)
  journalEntryId       String?   @map("journal_entry_id")
  cogsJournalEntryId   String?   @map("cogs_journal_entry_id")
  postedAt             DateTime? @map("posted_at")
  postedById           String?   @map("posted_by_id")
  createdById          String?   @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  business            Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer                    @relation(fields: [customerId], references: [id])
  warehouse           Warehouse?                  @relation(fields: [warehouseId], references: [id])
  branch              Branch?                     @relation("InvoiceRevenueBranch", fields: [branchId], references: [id], onDelete: SetNull)
  sellingBranch       Branch?                     @relation("InvoiceSellingBranch", fields: [sellingBranchId], references: [id], onDelete: SetNull)
  salesRep            SalesRep?                   @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  items               SalesInvoiceItem[]
  allocations         CustomerPaymentAllocation[]
  commissions         SalesCommission[]
  deliveries          DeliveryOrder[]
  fulfilments         SalesFulfilment[]
  pickupVerifications PickupVerification[]
  returns             SalesReturn[]
  amendments          SalesOrderAmendment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@index([customerId])
  @@map("sales_invoices")
}

/// Audit trail for controlled changes to a confirmed order (qty, warehouse, notes, delivery).
model SalesOrderAmendment {
  id              String   @id
  businessId      String   @map("business_id")
  invoiceId       String   @map("invoice_id")
  amendmentNumber String   @map("amendment_number")
  reason          String   @db.Text
  /// [{ field, invoice_item_id?, from, to }]
  changes         Json
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([businessId, amendmentNumber])
  @@index([invoiceId, createdAt])
  @@map("sales_order_amendments")
}

model SalesInvoiceItem {
  id                    String   @id
  invoiceId             String   @map("invoice_id")
  productId             String   @map("product_id")
  variantId             String?  @map("variant_id")
  uomId                 String?  @map("uom_id")
  quantity              Decimal  @db.Decimal(18, 4)
  /// Net price charged (after any branch discount)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(18, 4)
  /// List price before the branch discount (null when no discount applied)
  grossUnitPrice        Decimal? @map("gross_unit_price") @db.Decimal(18, 4)
  discountPercent       Decimal? @map("discount_percent") @db.Decimal(8, 4)
  /// Item-level discount money (qty × (gross − net unit)), 0 when none
  itemDiscountAmount    Decimal  @default(0) @map("item_discount_amount") @db.Decimal(18, 4)
  /// Net after item discount, before invoice special discount (qty × unit_price)
  lineTotal             Decimal  @map("line_total") @db.Decimal(18, 4)
  /// Share of invoice special discount allocated to this line
  allocatedDiscount     Decimal  @default(0) @map("allocated_discount") @db.Decimal(18, 4)
  /// Taxable consideration after special discount (ex-VAT)
  taxableAmount         Decimal  @default(0) @map("taxable_amount") @db.Decimal(18, 4)
  /// VAT % snapshotted from the product at sale time
  taxRate               Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  /// VAT amount for this line (tax-exclusive on taxableAmount)
  taxAmount             Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  priceLevel            String?  @map("price_level")
  stockMovementId       String?  @map("stock_movement_id")
  cogsAmount            Decimal  @default(0) @map("cogs_amount") @db.Decimal(18, 4)
  /// Warehouse the goods are picked from (null = invoice warehouse)
  fulfilmentWarehouseId String?  @map("fulfilment_warehouse_id")
  /// Quantity handed over so far, in the line UoM
  fulfilledQuantity     Decimal  @default(0) @map("fulfilled_quantity") @db.Decimal(18, 4)
  /// Ordered quantity in the product base UoM (set at confirmation)
  baseQuantity          Decimal? @map("base_quantity") @db.Decimal(18, 4)
  /// Quantity cancelled (never to be fulfilled), in the line UoM
  cancelledQuantity     Decimal  @default(0) @map("cancelled_quantity") @db.Decimal(18, 4)
  /// Revenue + tax recognised for this line so far
  recognisedAmount      Decimal  @default(0) @map("recognised_amount") @db.Decimal(18, 4)
  /// Quantity returned and posted (line UoM); cannot exceed fulfilledQuantity
  returnedQuantity      Decimal  @default(0) @map("returned_quantity") @db.Decimal(18, 4)
  /// Manual allocation chosen on the draft: [{ warehouse_id, quantity }] in the line UoM
  allocationPlan        Json?    @map("allocation_plan")

  invoice             SalesInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product               @relation(fields: [productId], references: [id])
  variant             ProductVariant?       @relation(fields: [variantId], references: [id])
  uom                 UnitOfMeasure?        @relation(fields: [uomId], references: [id])
  fulfilmentWarehouse Warehouse?            @relation(fields: [fulfilmentWarehouseId], references: [id])
  reservations        SalesReservation[]
  fulfilmentItems     SalesFulfilmentItem[]
  returnItems         SalesReturnItem[]

  @@index([invoiceId])
  @@index([fulfilmentWarehouseId])
  @@map("sales_invoice_items")
}

/// Stock lots committed to a posted invoice line until it is collected.
model SalesReservation {
  id                String    @id
  businessId        String    @map("business_id")
  invoiceItemId     String    @map("invoice_item_id")
  lotId             String    @map("lot_id")
  warehouseId       String    @map("warehouse_id")
  /// Base-UoM quantity reserved
  quantity          Decimal   @db.Decimal(18, 4)
  fulfilledQuantity Decimal   @default(0) @map("fulfilled_quantity") @db.Decimal(18, 4)
  releasedQuantity  Decimal   @default(0) @map("released_quantity") @db.Decimal(18, 4)
  /// active | fulfilled | released
  status            String    @default("active")
  /// auto | manual | reallocation | backorder
  method            String    @default("auto")
  branchId          String?   @map("branch_id")
  createdById       String?   @map("created_by_id")
  releasedById      String?   @map("released_by_id")
  releasedAt        DateTime? @map("released_at")
  /// cancelled | expired | reallocated | discrepancy | manual
  releaseReason     String?   @map("release_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  lot         StockLot         @relation(fields: [lotId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  serials     StockSerial[]

  @@index([invoiceItemId])
  @@index([lotId, status])
  @@index([warehouseId, status])
  @@map("sales_reservations")
}

/// Warehouse fulfilment of an order from one warehouse: picking → ready / dispatched → released / delivered.
/// Accounting (stock issue, revenue, COGS) posts once, when the record is released or delivered.
model SalesFulfilment {
  id                      String    @id
  businessId              String    @map("business_id")
  fulfilmentNumber        String    @map("fulfilment_number")
  invoiceId               String    @map("invoice_id")
  warehouseId             String    @map("warehouse_id")
  /// Branch of the fulfilling warehouse
  branchId                String    @map("branch_id")
  /// pickup | delivery
  fulfilmentType          String    @default("pickup") @map("fulfilment_type")
  /// picking | ready_for_collection | picked (delivery, awaiting dispatch) | dispatched |
  /// released | delivered | cancelled | discrepancy
  status                  String    @default("released")
  /// Remaining picked goods split off a partial collection
  splitFromId             String?   @map("split_from_id")
  pickerId                String?   @map("picker_id")
  pickStartedAt           DateTime? @map("pick_started_at")
  pickedAt                DateTime? @map("picked_at")
  readyAt                 DateTime? @map("ready_at")
  dispatchedAt            DateTime? @map("dispatched_at")
  dispatchedById          String?   @map("dispatched_by_id")
  deliveredAt             DateTime? @map("delivered_at")
  collectedBy             String?   @map("collected_by")
  collectorPhone          String?   @map("collector_phone")
  /// customer | authorised | other
  collectorRelation       String?   @map("collector_relation")
  /// Kind of ID shown (e.g. national_id, drivers_licence); only the last 4 characters are kept
  idType                  String?   @map("id_type")
  idReference             String?   @map("id_reference")
  /// code | override | none (counter sale)
  verificationMethod      String?   @map("verification_method")
  acknowledged            Boolean   @default(false)
  signatureName           String?   @map("signature_name")
  /// Proof of collection / delivery attachment reference (URL or document number)
  proofReference          String?   @map("proof_reference")
  discrepancyNotes        String?   @map("discrepancy_notes") @db.Text
  cancelledAt             DateTime? @map("cancelled_at")
  cancelledById           String?   @map("cancelled_by_id")
  cancelReason            String?   @map("cancel_reason") @db.Text
  notes                   String?   @db.Text
  totalCost               Decimal   @default(0) @map("total_cost") @db.Decimal(18, 4)
  /// Revenue + tax recognised by this hand-over
  recognisedAmount        Decimal   @default(0) @map("recognised_amount") @db.Decimal(18, 4)
  /// Deposit applied against the receivable raised by this hand-over
  depositApplied          Decimal   @default(0) @map("deposit_applied") @db.Decimal(18, 4)
  /// Revenue / AR journal in the revenue branch
  revenueJournalEntryId   String?   @map("revenue_journal_entry_id")
  /// COGS journal in the revenue branch
  cogsJournalEntryId      String?   @map("cogs_journal_entry_id")
  /// Inventory relief journal in the fulfilling branch (only when it differs from the revenue branch)
  inventoryJournalEntryId String?   @map("inventory_journal_entry_id")
  /// Employee who released / confirmed delivery (posting user)
  fulfilledById           String?   @map("fulfilled_by_id")
  /// When the goods were handed over (null until released or delivered)
  fulfilledAt             DateTime? @default(now()) @map("fulfilled_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice       SalesInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  branch        Branch                @relation(fields: [branchId], references: [id])
  items         SalesFulfilmentItem[]
  verifications PickupVerification[]
  proofs        FulfilmentProof[]
  deliveryOrder DeliveryOrder?
  returns       SalesReturn[]

  @@unique([businessId, fulfilmentNumber])
  @@index([invoiceId])
  @@index([businessId, warehouseId, status])
  @@map("sales_fulfilments")
}

/// Photo / PDF proof of collection or delivery stored on S3.
model FulfilmentProof {
  id           String   @id
  businessId   String   @map("business_id")
  fulfilmentId String   @map("fulfilment_id")
  /// collection | delivery | discrepancy | other
  kind         String   @default("collection")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  /// S3 object key
  storageKey   String   @map("storage_key")
  /// Public CDN / S3 URL
  url          String   @db.Text
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fulfilment SalesFulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId, createdAt])
  @@index([businessId])
  @@map("fulfilment_proofs")
}

model SalesFulfilmentItem {
  id               String  @id
  fulfilmentId     String  @map("fulfilment_id")
  invoiceItemId    String  @map("invoice_item_id")
  /// Quantity planned for picking (line UoM)
  plannedQuantity  Decimal @default(0) @map("planned_quantity") @db.Decimal(18, 4)
  /// Quantity actually picked (line UoM)
  pickedQuantity   Decimal @default(0) @map("picked_quantity") @db.Decimal(18, 4)
  /// Not found at picking — reservation released as a discrepancy (line UoM)
  shortQuantity    Decimal @default(0) @map("short_quantity") @db.Decimal(18, 4)
  /// Found damaged at picking — reservation released as a discrepancy (line UoM)
  damagedQuantity  Decimal @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  /// Quantity handed over / delivered (line UoM); 0 until released
  quantity         Decimal @db.Decimal(18, 4)
  baseQuantity     Decimal @map("base_quantity") @db.Decimal(18, 4)
  notes            String? @db.Text
  cost             Decimal @default(0) @db.Decimal(18, 4)
  recognisedAmount Decimal @default(0) @map("recognised_amount") @db.Decimal(18, 4)

  fulfilment  SalesFulfilment  @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId])
  @@index([invoiceItemId])
  @@map("sales_fulfilment_items")
}

/// Every pickup-code check at collection (success, failure, supervisor override) for accountability.
model PickupVerification {
  id            String   @id
  businessId    String   @map("business_id")
  invoiceId     String   @map("invoice_id")
  fulfilmentId  String?  @map("fulfilment_id")
  /// success | failed | locked | override
  result        String
  collectorName String?  @map("collector_name")
  reason        String?  @db.Text
  userId        String?  @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice    SalesInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fulfilment SalesFulfilment? @relation(fields: [fulfilmentId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@map("pickup_verifications")
}

/// Customer return of goods previously handed over. Stock restores only at the receiving warehouse.
/// Revenue / tax / COGS reverse in the original revenue branch; cross-branch uses clearing.
model SalesReturn {
  id                       String    @id
  businessId               String    @map("business_id")
  returnNumber             String    @map("return_number")
  invoiceId                String    @map("invoice_id")
  /// Optional: which hand-over the goods came from (helps cost and audit)
  fulfilmentId             String?   @map("fulfilment_id")
  customerId               String    @map("customer_id")
  /// Branch that physically received the goods
  branchId                 String    @map("branch_id")
  warehouseId              String    @map("warehouse_id")
  /// Invoice revenue branch (where AR / revenue / COGS reverse)
  revenueBranchId          String    @map("revenue_branch_id")
  /// draft | posted | void
  status                   String    @default("draft")
  /// Free-text reason (required on post)
  reason                   String?   @db.Text
  /// saleable | damaged | quarantine — default for lines that omit their own
  condition                String    @default("saleable")
  /// credit_note (reduce AR / raise unapplied credit) | refund (cash/bank out)
  settlement               String    @default("credit_note")
  refundMethod             String?   @map("refund_method")
  refundAccountId          String?   @map("refund_account_id")
  subtotal                 Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount                Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount              Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  /// Revenue + tax reversed
  recognisedReversal       Decimal   @default(0) @map("recognised_reversal") @db.Decimal(18, 4)
  /// Inventory / COGS cost reversed
  cogsReversal             Decimal   @default(0) @map("cogs_reversal") @db.Decimal(18, 4)
  /// Amount moved to unapplied customer credit (when settlement is credit_note and invoice was paid)
  creditIssued             Decimal   @default(0) @map("credit_issued") @db.Decimal(18, 4)
  /// Amount paid out in cash/bank (settlement = refund)
  refundAmount             Decimal   @default(0) @map("refund_amount") @db.Decimal(18, 4)
  revenueJournalEntryId    String?   @map("revenue_journal_entry_id")
  cogsJournalEntryId       String?   @map("cogs_journal_entry_id")
  inventoryJournalEntryId  String?   @map("inventory_journal_entry_id")
  settlementJournalEntryId String?   @map("settlement_journal_entry_id")
  creditPaymentId          String?   @map("credit_payment_id")
  notes                    String?   @db.Text
  createdById              String?   @map("created_by_id")
  postedById               String?   @map("posted_by_id")
  postedAt                 DateTime? @map("posted_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice       SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  fulfilment    SalesFulfilment?  @relation(fields: [fulfilmentId], references: [id], onDelete: SetNull)
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch        Branch            @relation("ReturnReceivingBranch", fields: [branchId], references: [id])
  revenueBranch Branch            @relation("ReturnRevenueBranch", fields: [revenueBranchId], references: [id])
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  items         SalesReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([invoiceId])
  @@index([customerId, status])
  @@index([businessId, branchId, status])
  @@map("sales_returns")
}

model SalesReturnItem {
  id               String  @id
  returnId         String  @map("return_id")
  invoiceItemId    String  @map("invoice_item_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  uomId            String? @map("uom_id")
  /// Quantity returned in the invoice line UoM
  quantity         Decimal @db.Decimal(18, 4)
  baseQuantity     Decimal @map("base_quantity") @db.Decimal(18, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 4)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 4)
  /// Revenue + tax share reversed for this line
  recognisedAmount Decimal @default(0) @map("recognised_amount") @db.Decimal(18, 4)
  /// Inventory cost restored / written off
  cost             Decimal @default(0) @db.Decimal(18, 4)
  /// saleable | damaged | quarantine
  condition        String  @default("saleable")
  /// When true, stock is received into the return warehouse; false → write-off only
  restock          Boolean @default(true)
  stockMovementId  String? @map("stock_movement_id")
  notes            String? @db.Text

  returnRow   SalesReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([invoiceItemId])
  @@map("sales_return_items")
}

model CustomerPayment {
  id              String   @id
  businessId      String   @map("business_id")
  branchId        String?  @map("branch_id")
  customerId      String   @map("customer_id")
  paymentNumber   String   @map("payment_number")
  paymentDate     DateTime @default(now()) @map("payment_date")
  amount          Decimal  @db.Decimal(18, 4)
  /// cash | bank | transfer | cheque | other
  method          String   @default("cash")
  accountId       String?  @map("account_id")
  reference       String?
  notes           String?  @db.Text
  journalEntryId  String?  @map("journal_entry_id")
  /// Advance / overpay still available to allocate or refund (GL lives on customer AR)
  unappliedAmount Decimal  @default(0) @map("unapplied_amount") @db.Decimal(18, 4)
  idempotencyKey  String?  @map("idempotency_key")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer                    @relation(fields: [customerId], references: [id])
  account     Account?                    @relation(fields: [accountId], references: [id])
  allocations CustomerPaymentAllocation[]

  @@unique([businessId, paymentNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([branchId])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id             String   @id
  paymentId      String   @map("payment_id")
  invoiceId      String   @map("invoice_id")
  amount         Decimal  @db.Decimal(18, 4)
  /// Portion that settled the recognised receivable when allocated
  arAmount       Decimal  @default(0) @map("ar_amount") @db.Decimal(18, 4)
  /// Portion held as a customer deposit against unrecognised order value
  depositAmount  Decimal  @default(0) @map("deposit_amount") @db.Decimal(18, 4)
  /// Deposit later returned to unapplied customer credit (e.g. order cancelled)
  releasedAmount Decimal  @default(0) @map("released_amount") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  payment CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice    @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("customer_payment_allocations")
}

model SalesCommission {
  id                String   @id
  businessId        String   @map("business_id")
  branchId          String?  @map("branch_id")
  salesRepId        String   @map("sales_rep_id")
  invoiceId         String   @map("invoice_id")
  baseAmount        Decimal  @map("base_amount") @db.Decimal(18, 4)
  commissionPercent Decimal  @map("commission_percent") @db.Decimal(8, 4)
  commissionAmount  Decimal  @map("commission_amount") @db.Decimal(18, 4)
  /// accrued | paid | void
  status            String   @default("accrued")
  /// Set when included in a payroll item and paid via payroll
  payrollItemId     String?  @map("payroll_item_id")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime @default(now()) @map("created_at")

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  salesRep    SalesRep     @relation(fields: [salesRepId], references: [id])
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payrollItem PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, salesRepId])
  @@index([businessId, salesRepId])
  @@index([branchId])
  @@index([payrollItemId])
  @@map("sales_commissions")
}

// ─── Phase 5: Banking / Expenses / Statements support ────────────────────────

model BankAccount {
  id             String   @id
  businessId     String   @map("business_id")
  branchId       String?  @map("branch_id")
  name           String
  bankName       String?  @map("bank_name")
  accountNumber  String?  @map("account_number")
  currencyCode   String   @default("NGN") @map("currency_code")
  glAccountId    String   @map("gl_account_id")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(18, 4)
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by_id")

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  glAccount    Account           @relation(fields: [glAccountId], references: [id])
  transactions BankTransaction[] @relation("BankTxnAccount")
  transfersIn  BankTransaction[] @relation("BankTxnCounterparty")
  expenseBills ExpenseBill[]

  @@index([businessId])
  @@index([branchId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                        String   @id
  businessId                String   @map("business_id")
  branchId                  String?  @map("branch_id")
  bankAccountId             String   @map("bank_account_id")
  txnNumber                 String   @map("txn_number")
  txnDate                   DateTime @default(now()) @map("txn_date")
  /// deposit | withdrawal | transfer
  type                      String
  amount                    Decimal  @db.Decimal(18, 4)
  counterpartyBankAccountId String?  @map("counterparty_bank_account_id")
  offsetAccountId           String?  @map("offset_account_id")
  memo                      String?  @db.Text
  reference                 String?
  journalEntryId            String?  @map("journal_entry_id")
  status                    String   @default("posted")
  createdById               String?  @map("created_by_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  business                Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                  Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bankAccount             BankAccount  @relation("BankTxnAccount", fields: [bankAccountId], references: [id])
  counterpartyBankAccount BankAccount? @relation("BankTxnCounterparty", fields: [counterpartyBankAccountId], references: [id])
  offsetAccount           Account?     @relation("BankTxnOffsetAccount", fields: [offsetAccountId], references: [id])

  @@unique([businessId, txnNumber])
  @@index([businessId, bankAccountId])
  @@index([branchId])
  @@map("bank_transactions")
}

model ExpenseBill {
  id                    String    @id
  businessId            String    @map("business_id")
  branchId              String?   @map("branch_id")
  expenseNumber         String    @map("expense_number")
  vendorName            String?   @map("vendor_name")
  supplierId            String?   @map("supplier_id")
  expenseDate           DateTime  @default(now()) @map("expense_date")
  dueDate               DateTime? @map("due_date")
  /// draft | posted | void
  status                String    @default("draft")
  /// open | partial | paid
  paymentStatus         String    @default("open") @map("payment_status")
  subtotal              Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount             Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount           Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  amountPaid            Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 4)
  balance               Decimal   @default(0) @db.Decimal(18, 4)
  /// cash | bank | ap
  payMethod             String?   @map("pay_method")
  bankAccountId         String?   @map("bank_account_id")
  /// Asset GL credited when posting (cash/bank/petty cash, etc.)
  fundingAccountId      String?   @map("funding_account_id")
  journalEntryId        String?   @map("journal_entry_id")
  paymentJournalEntryId String?   @map("payment_journal_entry_id")
  notes                 String?   @db.Text
  createdById           String?   @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier       Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount    BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  fundingAccount Account?          @relation("ExpenseFundingAccount", fields: [fundingAccountId], references: [id], onDelete: SetNull)
  lines          ExpenseBillLine[]

  @@unique([businessId, expenseNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@index([fundingAccountId])
  @@map("expense_bills")
}

model ExpenseBillLine {
  id                String  @id
  expenseId         String  @map("expense_id")
  accountId         String  @map("account_id")
  expenseCategoryId String? @map("expense_category_id")
  description       String?
  amount            Decimal @db.Decimal(18, 4)

  expense         ExpenseBill      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id])
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  @@index([expenseId])
  @@index([expenseCategoryId])
  @@map("expense_bill_lines")
}

/// Named expense type bound to a GL account — drives expense pickers without a parallel posting model.
model ExpenseCategory {
  id          String   @id
  businessId  String   @map("business_id")
  name        String
  code        String?
  accountId   String   @map("account_id")
  isActive    Boolean  @default(true) @map("is_active")
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account  Account           @relation(fields: [accountId], references: [id])
  lines    ExpenseBillLine[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([accountId])
  @@map("expense_categories")
}

// --- Phase 6+: Assets / Depreciation / Budgeting (Asset Mgmt Phase 1+) -------

model AssetCategory {
  id                         String   @id
  businessId                 String   @map("business_id")
  code                       String
  name                       String
  description                String?  @db.Text
  /// tangible | intangible | investment_property | other
  assetType                  String   @default("tangible") @map("asset_type")
  capitalisationThreshold    Decimal  @default(0) @map("capitalisation_threshold") @db.Decimal(18, 4)
  defaultUsefulLifeMonths    Int      @default(36) @map("default_useful_life_months")
  /// straight_line | reducing_balance | units_of_production | none
  defaultDepreciationMethod  String   @default("straight_line") @map("default_depreciation_method")
  defaultResidualPercent     Decimal  @default(0) @map("default_residual_percent") @db.Decimal(8, 4)
  costAccountId              String?  @map("cost_account_id")
  accumDepAccountId          String?  @map("accum_dep_account_id")
  depExpenseAccountId        String?  @map("dep_expense_account_id")
  impairmentAccountId        String?  @map("impairment_account_id")
  disposalGainAccountId      String?  @map("disposal_gain_account_id")
  disposalLossAccountId      String?  @map("disposal_loss_account_id")
  cipAccountId               String?  @map("cip_account_id")
  isActive                   Boolean  @default(true) @map("is_active")
  createdById                String?  @map("created_by_id")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  costAccount         Account?     @relation("AssetCategoryCostAccount", fields: [costAccountId], references: [id], onDelete: SetNull)
  accumDepAccount     Account?     @relation("AssetCategoryAccumDepAccount", fields: [accumDepAccountId], references: [id], onDelete: SetNull)
  depExpenseAccount   Account?     @relation("AssetCategoryDepExpenseAccount", fields: [depExpenseAccountId], references: [id], onDelete: SetNull)
  impairmentAccount   Account?     @relation("AssetCategoryImpairmentAccount", fields: [impairmentAccountId], references: [id], onDelete: SetNull)
  disposalGainAccount Account?     @relation("AssetCategoryDisposalGainAccount", fields: [disposalGainAccountId], references: [id], onDelete: SetNull)
  disposalLossAccount Account?     @relation("AssetCategoryDisposalLossAccount", fields: [disposalLossAccountId], references: [id], onDelete: SetNull)
  cipAccount          Account?     @relation("AssetCategoryCipAccount", fields: [cipAccountId], references: [id], onDelete: SetNull)
  assets              FixedAsset[]
  acquisitions        AssetAcquisition[]
  capitalProjects     CapitalProject[]
  verificationCampaigns AssetVerificationCampaign[]
  budgetLines         BudgetLine[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("asset_categories")
}

model AssetLocation {
  id          String   @id
  businessId  String   @map("business_id")
  branchId    String?  @map("branch_id")
  code        String
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assets       FixedAsset[]
  acquisitions AssetAcquisition[]
  verificationCampaigns AssetVerificationCampaign[]

  @@unique([businessId, code])
  @@index([businessId, branchId])
  @@index([businessId, isActive])
  @@map("asset_locations")
}

model FixedAsset {
  id                        String    @id
  businessId                String    @map("business_id")
  branchId                  String?   @map("branch_id")
  code                      String?
  name                      String
  description               String?   @db.Text
  /// Legacy free-text category (kept for back-compat; prefer categoryId)
  category                  String    @default("equipment")
  categoryId                String?   @map("category_id")
  /// tangible | intangible | investment_property | other
  assetType                 String    @default("tangible") @map("asset_type")
  parentAssetId             String?   @map("parent_asset_id")
  manufacturer              String?
  model                     String?
  serialNumber              String?   @map("serial_number")
  barcode                   String?
  qrPayload                 String?   @map("qr_payload") @db.Text
  photoUrl                  String?   @map("photo_url")
  /// direct | purchase_order | grn | supplier_bill | opening_balance | donation | cip | other
  acquisitionSource         String    @default("direct") @map("acquisition_source")
  supplierId                String?   @map("supplier_id")
  purchaseOrderId           String?   @map("purchase_order_id")
  grnId                     String?   @map("grn_id")
  supplierBillId            String?   @map("supplier_bill_id")
  purchaseDate              DateTime  @map("purchase_date")
  capitalisationDate        DateTime? @map("capitalisation_date")
  availableForUseDate       DateTime? @map("available_for_use_date")
  depreciationStartDate     DateTime? @map("depreciation_start_date")
  purchaseCost              Decimal   @map("purchase_cost") @db.Decimal(18, 4)
  freightCost               Decimal   @default(0) @map("freight_cost") @db.Decimal(18, 4)
  installationCost          Decimal   @default(0) @map("installation_cost") @db.Decimal(18, 4)
  otherCapitalCost          Decimal   @default(0) @map("other_capital_cost") @db.Decimal(18, 4)
  currencyCode              String    @default("NGN") @map("currency_code")
  exchangeRate              Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  salvageValue              Decimal   @default(0) @map("salvage_value") @db.Decimal(18, 4)
  usefulLifeMonths          Int       @default(36) @map("useful_life_months")
  /// straight_line | reducing_balance | units_of_production | none
  depreciationMethod        String    @default("straight_line") @map("depreciation_method")
  reducingBalanceRate       Decimal?  @map("reducing_balance_rate") @db.Decimal(8, 4)
  estimatedProductionUnits  Decimal?  @map("estimated_production_units") @db.Decimal(18, 4)
  accumulatedDepreciation   Decimal   @default(0) @map("accumulated_depreciation") @db.Decimal(18, 4)
  accumulatedImpairment     Decimal   @default(0) @map("accumulated_impairment") @db.Decimal(18, 4)
  /// Legacy: active | fully_depreciated | disposed — synced with operational/financial status
  status                    String    @default("active")
  /// draft | pending_approval | acquired | cip | available | in_use | under_maintenance | idle | transfer_pending | disposal_pending | disposed | archived
  operationalStatus         String    @default("in_use") @map("operational_status")
  /// not_capitalised | capitalised | depreciating | fully_depreciated | impaired | disposed
  financialStatus           String    @default("capitalised") @map("financial_status")
  /// new | good | fair | poor | damaged
  condition                 String    @default("good")
  department                String?
  locationId                String?   @map("location_id")
  warehouseId               String?   @map("warehouse_id")
  costCentre                String?   @map("cost_centre")
  custodianEmployeeId       String?   @map("custodian_employee_id")
  costAccountId             String?   @map("cost_account_id")
  accumDepAccountId         String?   @map("accum_dep_account_id")
  depExpenseAccountId       String?   @map("dep_expense_account_id")
  bookCode                  String    @default("financial") @map("book_code")
  isOpeningBalance          Boolean   @default(false) @map("is_opening_balance")
  warrantyProvider          String?   @map("warranty_provider")
  warrantyExpiryDate        DateTime? @map("warranty_expiry_date")
  insuranceCompany          String?   @map("insurance_company")
  insurancePolicy           String?   @map("insurance_policy")
  insuranceExpiryDate       DateTime? @map("insurance_expiry_date")
  maintenanceFrequencyDays  Int?      @map("maintenance_frequency_days")
  lastMaintenanceDate       DateTime? @map("last_maintenance_date")
  nextMaintenanceDate       DateTime? @map("next_maintenance_date")
  notes                     String?   @db.Text
  acquisitionJournalEntryId String?   @map("acquisition_journal_entry_id")
  version                   Int       @default(1)
  createdById               String?   @map("created_by_id")
  updatedById               String?   @map("updated_by_id")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  business            Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch              Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assetCategory       AssetCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentAsset         FixedAsset?              @relation("AssetHierarchy", fields: [parentAssetId], references: [id], onDelete: SetNull)
  childAssets         FixedAsset[]             @relation("AssetHierarchy")
  supplier            Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location            AssetLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  warehouse           Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  custodian           Employee?                @relation("AssetCustodian", fields: [custodianEmployeeId], references: [id], onDelete: SetNull)
  costAccount         Account?                 @relation("FixedAssetCostAccount", fields: [costAccountId], references: [id], onDelete: SetNull)
  accumDepAccount     Account?                 @relation("FixedAssetAccumDepAccount", fields: [accumDepAccountId], references: [id], onDelete: SetNull)
  depExpenseAccount   Account?                 @relation("FixedAssetDepExpenseAccount", fields: [depExpenseAccountId], references: [id], onDelete: SetNull)
  depreciationEntries DepreciationEntry[]
  depreciationRunLines AssetDepreciationRunLine[]
  assignmentHistory   AssetAssignmentHistory[]
  statusHistory       AssetStatusHistory[]
  documents           AssetDocument[]
  acquisitions        AssetAcquisition[]       @relation("AcquisitionCapitalisedAsset")
  costAdditions       AssetCostAddition[]
  capitalisations     AssetCapitalisation[]
  transferLines       AssetTransferLine[]
  maintenanceRequests AssetMaintenanceRequest[]
  maintenanceWorkOrders AssetMaintenanceWorkOrder[]
  maintenanceCosts    AssetMaintenanceCost[]
  insurances          AssetInsurance[]
  insuranceClaims     AssetInsuranceClaim[]
  warranties          AssetWarranty[]
  capitalProjects     CapitalProject[]       @relation("CapitalProjectAsset")
  componentsAsParent  AssetComponent[]       @relation("ComponentParent")
  componentsAsChild   AssetComponent[]       @relation("ComponentChild")
  impairments         AssetImpairment[]
  revaluations        AssetRevaluation[]
  disposals           AssetDisposal[]
  accountingEvents    AssetAccountingEvent[]
  verificationResults AssetVerificationResult[]

  @@unique([businessId, code])
  @@unique([businessId, serialNumber])
  @@index([businessId, status])
  @@index([businessId, operationalStatus])
  @@index([businessId, financialStatus])
  @@index([businessId, categoryId])
  @@index([businessId, model])
  @@index([branchId])
  @@index([custodianEmployeeId])
  @@index([barcode])
  @@map("fixed_assets")
}

/// Draft → pending_approval → approved → capitalised (or cancelled)
model AssetAcquisition {
  id                   String    @id
  businessId           String    @map("business_id")
  branchId             String?   @map("branch_id")
  acquisitionNumber    String    @map("acquisition_number")
  /// draft | pending_approval | approved | capitalised | cancelled
  status               String    @default("draft")
  /// direct | purchase_order | grn | supplier_bill | opening_balance | donation | other
  source               String    @default("direct")
  supplierId           String?   @map("supplier_id")
  purchaseOrderId      String?   @map("purchase_order_id")
  grnId                String?   @map("grn_id")
  supplierBillId       String?   @map("supplier_bill_id")
  categoryId           String?   @map("category_id")
  locationId           String?   @map("location_id")
  assetName            String    @map("asset_name")
  assetCode            String?   @map("asset_code")
  description          String?   @db.Text
  manufacturer         String?
  model                String?
  /// Single-unit convenience; prefer serialNumbersJson for bulk
  serialNumber         String?   @map("serial_number")
  /// JSON string array of serial numbers (one per unit when quantity > 1)
  serialNumbersJson    String?   @map("serial_numbers_json") @db.Text
  /// Number of individual assets to capitalise from this acquisition
  quantity             Int       @default(1)
  /// Cost per unit (purchase). Lot purchase_cost = unit_cost × quantity
  unitCost             Decimal   @default(0) @map("unit_cost") @db.Decimal(18, 4)
  acquisitionDate      DateTime  @map("acquisition_date")
  availableForUseDate  DateTime? @map("available_for_use_date")
  /// Lot total for purchase (unit_cost × quantity)
  purchaseCost         Decimal   @map("purchase_cost") @db.Decimal(18, 4)
  freightCost          Decimal   @default(0) @map("freight_cost") @db.Decimal(18, 4)
  installationCost     Decimal   @default(0) @map("installation_cost") @db.Decimal(18, 4)
  otherCapitalCost     Decimal   @default(0) @map("other_capital_cost") @db.Decimal(18, 4)
  /// For opening balances only
  openingAccumDep      Decimal   @default(0) @map("opening_accum_dep") @db.Decimal(18, 4)
  salvageValue         Decimal   @default(0) @map("salvage_value") @db.Decimal(18, 4)
  usefulLifeMonths     Int       @default(36) @map("useful_life_months")
  depreciationMethod   String    @default("straight_line") @map("depreciation_method")
  currencyCode         String    @default("NGN") @map("currency_code")
  exchangeRate         Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  /// bank | cash | credit | equity | opening | donation | inventory_reclass
  fundingMethod        String    @default("bank") @map("funding_method")
  bankAccountId        String?   @map("bank_account_id")
  notes                String?   @db.Text
  submittedAt          DateTime? @map("submitted_at")
  approvedAt           DateTime? @map("approved_at")
  approvedById         String?   @map("approved_by_id")
  capitalisedAssetId   String?   @map("capitalised_asset_id")
  createdById          String?   @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category         AssetCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location         AssetLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  capitalisedAsset FixedAsset?          @relation("AcquisitionCapitalisedAsset", fields: [capitalisedAssetId], references: [id], onDelete: SetNull)
  costAdditions    AssetCostAddition[]
  capitalisations  AssetCapitalisation[]

  @@unique([businessId, acquisitionNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@map("asset_acquisitions")
}

model AssetCostAddition {
  id            String   @id
  businessId    String   @map("business_id")
  acquisitionId String?  @map("acquisition_id")
  assetId       String?  @map("asset_id")
  /// purchase_order_item | grn_item | supplier_bill_line | manual
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  sourceLineId  String   @default("") @map("source_line_id")
  description   String?
  amount        Decimal  @db.Decimal(18, 4)
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  acquisition AssetAcquisition? @relation(fields: [acquisitionId], references: [id], onDelete: Cascade)
  asset       FixedAsset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([businessId, sourceType, sourceId, sourceLineId])
  @@index([businessId, acquisitionId])
  @@index([businessId, assetId])
  @@map("asset_cost_additions")
}

model AssetCapitalisation {
  id                String   @id
  businessId        String   @map("business_id")
  acquisitionId     String   @map("acquisition_id")
  assetId           String   @map("asset_id")
  capitalisedAmount Decimal  @map("capitalised_amount") @db.Decimal(18, 4)
  journalEntryId    String?  @map("journal_entry_id")
  capitalisedAt     DateTime @default(now()) @map("capitalised_at")
  capitalisedById   String?  @map("capitalised_by_id")
  notes             String?  @db.Text

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  acquisition AssetAcquisition @relation(fields: [acquisitionId], references: [id], onDelete: Restrict)
  asset       FixedAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([acquisitionId, assetId])
  @@index([businessId, acquisitionId])
  @@index([businessId, assetId])
  @@map("asset_capitalisations")
}

// --- Phase 4: Operations (transfer / maintenance / insurance / warranty) ----

model AssetTransfer {
  id              String    @id
  businessId      String    @map("business_id")
  transferNumber  String    @map("transfer_number")
  /// draft | pending_approval | approved | in_transit | received | cancelled
  status          String    @default("draft")
  fromBranchId    String?   @map("from_branch_id")
  toBranchId      String?   @map("to_branch_id")
  reason          String?   @db.Text
  notes           String?   @db.Text
  requestedAt     DateTime  @default(now()) @map("requested_at")
  approvedAt      DateTime? @map("approved_at")
  approvedById    String?   @map("approved_by_id")
  dispatchedAt    DateTime? @map("dispatched_at")
  dispatchedById  String?   @map("dispatched_by_id")
  receivedAt      DateTime? @map("received_at")
  receivedById    String?   @map("received_by_id")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromBranch Branch?             @relation("AssetTransferFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch   Branch?             @relation("AssetTransferToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)
  lines      AssetTransferLine[]

  @@unique([businessId, transferNumber])
  @@index([businessId, status])
  @@map("asset_transfers")
}

model AssetTransferLine {
  id                 String  @id
  businessId         String  @map("business_id")
  transferId         String  @map("transfer_id")
  assetId            String  @map("asset_id")
  fromLocationId     String? @map("from_location_id")
  toLocationId       String? @map("to_location_id")
  fromDepartment     String? @map("from_department")
  toDepartment       String? @map("to_department")
  fromCustodianId    String? @map("from_custodian_id")
  toCustodianId      String? @map("to_custodian_id")
  notes              String? @db.Text

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transfer AssetTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  asset    FixedAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([transferId, assetId])
  @@index([businessId, transferId])
  @@index([assetId])
  @@map("asset_transfer_lines")
}

model AssetMaintenanceRequest {
  id              String    @id
  businessId      String    @map("business_id")
  requestNumber   String    @map("request_number")
  assetId         String    @map("asset_id")
  /// draft | submitted | approved | rejected | cancelled | converted
  status          String    @default("draft")
  /// corrective | preventive | inspection | other
  requestType     String    @default("corrective") @map("request_type")
  /// low | medium | high | critical
  priority        String    @default("medium")
  title           String
  description     String?   @db.Text
  requestedById   String?   @map("requested_by_id")
  approvedAt      DateTime? @map("approved_at")
  approvedById    String?   @map("approved_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business   Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset      FixedAsset                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  workOrders AssetMaintenanceWorkOrder[]

  @@unique([businessId, requestNumber])
  @@index([businessId, status])
  @@index([assetId])
  @@map("asset_maintenance_requests")
}

model AssetMaintenanceWorkOrder {
  id              String    @id
  businessId      String    @map("business_id")
  workOrderNumber String    @map("work_order_number")
  requestId       String?   @map("request_id")
  assetId         String    @map("asset_id")
  /// open | in_progress | completed | cancelled
  status          String    @default("open")
  title           String
  description     String?   @db.Text
  assignedToName  String?   @map("assigned_to_name")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  completedById   String?   @map("completed_by_id")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  request  AssetMaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  asset    FixedAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  costs    AssetMaintenanceCost[]

  @@unique([businessId, workOrderNumber])
  @@index([businessId, status])
  @@index([assetId])
  @@map("asset_maintenance_work_orders")
}

model AssetMaintenanceCost {
  id           String   @id
  businessId   String   @map("business_id")
  workOrderId  String   @map("work_order_id")
  assetId      String   @map("asset_id")
  /// labour | parts | external | other
  costType     String   @default("other") @map("cost_type")
  description  String
  amount       Decimal  @db.Decimal(18, 4)
  /// Optional stock issue for parts
  productId    String?  @map("product_id")
  warehouseId  String?  @map("warehouse_id")
  quantity     Decimal? @db.Decimal(18, 4)
  stockMovementId String? @map("stock_movement_id")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  business  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workOrder AssetMaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  asset     FixedAsset               @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([businessId, workOrderId])
  @@index([assetId])
  @@map("asset_maintenance_costs")
}

model AssetInsurance {
  id              String    @id
  businessId      String    @map("business_id")
  assetId         String    @map("asset_id")
  insurerName     String    @map("insurer_name")
  policyNumber    String    @map("policy_number")
  coverageType    String?   @map("coverage_type")
  sumInsured      Decimal?  @map("sum_insured") @db.Decimal(18, 4)
  premiumAmount   Decimal?  @map("premium_amount") @db.Decimal(18, 4)
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  /// active | expired | cancelled
  status          String    @default("active")
  notes           String?   @db.Text
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  claims   AssetInsuranceClaim[]

  @@index([businessId, assetId])
  @@index([businessId, status])
  @@map("asset_insurances")
}

model AssetInsuranceClaim {
  id              String    @id
  businessId      String    @map("business_id")
  insuranceId     String    @map("insurance_id")
  assetId         String    @map("asset_id")
  claimNumber     String    @map("claim_number")
  /// open | submitted | settled | denied | withdrawn
  status          String    @default("open")
  claimDate       DateTime  @map("claim_date")
  description     String?   @db.Text
  claimAmount     Decimal   @default(0) @map("claim_amount") @db.Decimal(18, 4)
  settledAmount   Decimal?  @map("settled_amount") @db.Decimal(18, 4)
  settledAt       DateTime? @map("settled_at")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  insurance AssetInsurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  asset     FixedAsset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([businessId, claimNumber])
  @@index([businessId, insuranceId])
  @@index([assetId])
  @@map("asset_insurance_claims")
}

model AssetWarranty {
  id              String    @id
  businessId      String    @map("business_id")
  assetId         String    @map("asset_id")
  providerName    String    @map("provider_name")
  warrantyNumber  String?   @map("warranty_number")
  coverageNotes   String?   @map("coverage_notes") @db.Text
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  /// active | expired | void
  status          String    @default("active")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([businessId, assetId])
  @@index([businessId, status])
  @@map("asset_warranties")
}

// --- Phase 5: Advanced accounting (CIP / components / impairment / reval / disposal) ---

model CapitalProject {
  id               String    @id
  businessId       String    @map("business_id")
  branchId         String?   @map("branch_id")
  projectNumber    String    @map("project_number")
  name             String
  description      String?   @db.Text
  categoryId       String?   @map("category_id")
  /// draft | active | completed | capitalised | cancelled
  status           String    @default("draft")
  totalCost        Decimal   @default(0) @map("total_cost") @db.Decimal(18, 4)
  startDate        DateTime? @map("start_date")
  completedAt      DateTime? @map("completed_at")
  capitalisedAt    DateTime? @map("capitalised_at")
  capitalisedAssetId String? @map("capitalised_asset_id")
  journalEntryId   String?   @map("journal_entry_id")
  notes            String?   @db.Text
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category         AssetCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  capitalisedAsset FixedAsset?         @relation("CapitalProjectAsset", fields: [capitalisedAssetId], references: [id], onDelete: SetNull)
  costs            CapitalProjectCost[]

  @@unique([businessId, projectNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@map("capital_projects")
}

model CapitalProjectCost {
  id             String   @id
  businessId     String   @map("business_id")
  projectId      String   @map("project_id")
  /// bank | cash | credit | inventory | manual
  fundingMethod  String   @default("bank") @map("funding_method")
  description    String?
  amount         Decimal  @db.Decimal(18, 4)
  costDate       DateTime @map("cost_date")
  bankAccountId  String?  @map("bank_account_id")
  journalEntryId String?  @map("journal_entry_id")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  CapitalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([businessId, projectId])
  @@map("capital_project_costs")
}

/// Component / sub-asset link (optional child register asset)
model AssetComponent {
  id               String   @id
  businessId       String   @map("business_id")
  parentAssetId    String   @map("parent_asset_id")
  childAssetId     String?  @map("child_asset_id")
  name             String
  description      String?  @db.Text
  costAmount       Decimal  @default(0) @map("cost_amount") @db.Decimal(18, 4)
  usefulLifeMonths Int?     @map("useful_life_months")
  /// active | retired
  status           String   @default("active")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentAsset FixedAsset @relation("ComponentParent", fields: [parentAssetId], references: [id], onDelete: Restrict)
  childAsset  FixedAsset? @relation("ComponentChild", fields: [childAssetId], references: [id], onDelete: SetNull)

  @@index([businessId, parentAssetId])
  @@index([businessId, childAssetId])
  @@map("asset_components")
}

model AssetImpairment {
  id               String    @id
  businessId       String    @map("business_id")
  branchId         String?   @map("branch_id")
  impairmentNumber String    @map("impairment_number")
  assetId          String    @map("asset_id")
  /// draft | posted | reversed
  status           String    @default("draft")
  impairmentDate   DateTime  @map("impairment_date")
  amount           Decimal   @db.Decimal(18, 4)
  carryingBefore   Decimal   @map("carrying_before") @db.Decimal(18, 4)
  carryingAfter    Decimal   @map("carrying_after") @db.Decimal(18, 4)
  reason           String?   @db.Text
  journalEntryId   String?   @map("journal_entry_id")
  postedAt         DateTime? @map("posted_at")
  postedById       String?   @map("posted_by_id")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([businessId, impairmentNumber])
  @@index([businessId, assetId])
  @@index([businessId, status])
  @@map("asset_impairments")
}

model AssetRevaluation {
  id                String    @id
  businessId        String    @map("business_id")
  branchId          String?   @map("branch_id")
  revaluationNumber String    @map("revaluation_number")
  assetId           String    @map("asset_id")
  /// draft | posted | reversed
  status            String    @default("draft")
  revaluationDate   DateTime  @map("revaluation_date")
  /// Absolute fair / revalued carrying amount after posting
  newCarryingAmount Decimal   @map("new_carrying_amount") @db.Decimal(18, 4)
  carryingBefore    Decimal   @map("carrying_before") @db.Decimal(18, 4)
  adjustmentAmount  Decimal   @map("adjustment_amount") @db.Decimal(18, 4)
  reason            String?   @db.Text
  journalEntryId    String?   @map("journal_entry_id")
  postedAt          DateTime? @map("posted_at")
  postedById        String?   @map("posted_by_id")
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([businessId, revaluationNumber])
  @@index([businessId, assetId])
  @@index([businessId, status])
  @@map("asset_revaluations")
}

model AssetDisposal {
  id              String    @id
  businessId      String    @map("business_id")
  branchId        String?   @map("branch_id")
  disposalNumber  String    @map("disposal_number")
  assetId         String    @map("asset_id")
  /// draft | pending_approval | approved | posted | cancelled
  status          String    @default("draft")
  /// sale | scrap | donation | write_off | other
  disposalType    String    @default("sale") @map("disposal_type")
  disposalDate    DateTime  @map("disposal_date")
  proceeds        Decimal   @default(0) @db.Decimal(18, 4)
  /// bank | cash | none
  proceedsMethod  String    @default("bank") @map("proceeds_method")
  bankAccountId   String?   @map("bank_account_id")
  costAmount      Decimal   @default(0) @map("cost_amount") @db.Decimal(18, 4)
  accumDepAmount  Decimal   @default(0) @map("accum_dep_amount") @db.Decimal(18, 4)
  accumImpAmount  Decimal   @default(0) @map("accum_imp_amount") @db.Decimal(18, 4)
  nbvAmount       Decimal   @default(0) @map("nbv_amount") @db.Decimal(18, 4)
  gainLossAmount  Decimal   @default(0) @map("gain_loss_amount") @db.Decimal(18, 4)
  reason          String?   @db.Text
  journalEntryId  String?   @map("journal_entry_id")
  approvedAt      DateTime? @map("approved_at")
  approvedById    String?   @map("approved_by_id")
  postedAt        DateTime? @map("posted_at")
  postedById      String?   @map("posted_by_id")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([businessId, disposalNumber])
  @@index([businessId, assetId])
  @@index([businessId, status])
  @@map("asset_disposals")
}

/// Immutable ledger of posted asset accounting events (audit / reconciliation)
model AssetAccountingEvent {
  id             String   @id
  businessId     String   @map("business_id")
  assetId        String?  @map("asset_id")
  /// cip_spend | cip_capitalise | impairment | revaluation | disposal | component
  eventType      String   @map("event_type")
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  amount         Decimal  @default(0) @db.Decimal(18, 4)
  journalEntryId String?  @map("journal_entry_id")
  summary        String?  @db.Text
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([businessId, eventType])
  @@index([businessId, assetId])
  @@index([businessId, sourceType, sourceId])
  @@map("asset_accounting_events")
}

// --- Phase 6: Physical verification (QR / barcode campaigns) ----------------

model AssetVerificationCampaign {
  id              String    @id
  businessId      String    @map("business_id")
  branchId        String?   @map("branch_id")
  locationId      String?   @map("location_id")
  categoryId      String?   @map("category_id")
  campaignNumber  String    @map("campaign_number")
  name            String
  description     String?   @db.Text
  /// draft | open | closed | cancelled
  status          String    @default("draft")
  expectedCount   Int       @default(0) @map("expected_count")
  scannedCount    Int       @default(0) @map("scanned_count")
  matchedCount    Int       @default(0) @map("matched_count")
  mismatchCount   Int       @default(0) @map("mismatch_count")
  missingCount    Int       @default(0) @map("missing_count")
  unexpectedCount Int       @default(0) @map("unexpected_count")
  openedAt        DateTime? @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business  Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  location  AssetLocation?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category  AssetCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  results   AssetVerificationResult[]

  @@unique([businessId, campaignNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@map("asset_verification_campaigns")
}

model AssetVerificationResult {
  id                   String    @id
  businessId           String    @map("business_id")
  campaignId           String    @map("campaign_id")
  assetId              String?   @map("asset_id")
  /// expected | matched | mismatch | missing | unexpected | resolved
  status               String    @default("expected")
  scannedCode          String?   @map("scanned_code")
  expectedBranchId     String?   @map("expected_branch_id")
  foundBranchId        String?   @map("found_branch_id")
  expectedLocationId   String?   @map("expected_location_id")
  foundLocationId      String?   @map("found_location_id")
  expectedCustodianId  String?   @map("expected_custodian_id")
  foundCustodianId     String?   @map("found_custodian_id")
  expectedCondition    String?   @map("expected_condition")
  foundCondition       String?   @map("found_condition")
  notes                String?   @db.Text
  scannedAt            DateTime? @map("scanned_at")
  scannedById          String?   @map("scanned_by_id")
  /// accept_found | correct_register | ignore | mark_missing
  resolutionAction     String?   @map("resolution_action")
  resolvedAt           DateTime? @map("resolved_at")
  resolvedById         String?   @map("resolved_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  business Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign AssetVerificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset    FixedAsset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([campaignId, assetId])
  @@index([businessId, campaignId])
  @@index([businessId, status])
  @@index([assetId])
  @@map("asset_verification_results")
}

model AssetAssignmentHistory {
  id                   String   @id
  businessId           String   @map("business_id")
  assetId              String   @map("asset_id")
  fromBranchId          String?  @map("from_branch_id")
  toBranchId           String?  @map("to_branch_id")
  fromLocationId       String?  @map("from_location_id")
  toLocationId         String?  @map("to_location_id")
  fromDepartment       String?  @map("from_department")
  toDepartment         String?  @map("to_department")
  fromCustodianId      String?  @map("from_custodian_id")
  toCustodianId        String?  @map("to_custodian_id")
  fromWarehouseId      String?  @map("from_warehouse_id")
  toWarehouseId        String?  @map("to_warehouse_id")
  reason               String?  @db.Text
  changedById          String?  @map("changed_by_id")
  changedAt            DateTime @default(now()) @map("changed_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([businessId, assetId])
  @@index([assetId, changedAt])
  @@map("asset_assignment_history")
}

model AssetStatusHistory {
  id         String   @id
  businessId String   @map("business_id")
  assetId    String   @map("asset_id")
  field      String
  fromValue  String?  @map("from_value")
  toValue    String?  @map("to_value")
  reason     String?  @db.Text
  changedById String? @map("changed_by_id")
  changedAt  DateTime @default(now()) @map("changed_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([businessId, assetId])
  @@map("asset_status_history")
}

model AssetDocument {
  id           String   @id
  businessId   String   @map("business_id")
  assetId      String   @map("asset_id")
  /// photo | invoice | warranty | insurance | other
  docType      String   @default("other") @map("doc_type")
  fileName     String   @map("file_name")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  storageKey   String   @map("storage_key")
  url          String
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([businessId, assetId])
  @@map("asset_documents")
}

model AssetDepreciationBook {
  id          String   @id
  businessId  String   @map("business_id")
  code        String
  name        String
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs     AssetDepreciationRun[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("asset_depreciation_books")
}

model AssetDepreciationRun {
  id                   String    @id
  businessId           String    @map("business_id")
  bookId               String    @map("book_id")
  runNumber            String    @map("run_number")
  /// YYYY-MM
  periodLabel          String    @map("period_label")
  /// draft | previewed | approved | posted | reversed
  status               String    @default("draft")
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  lineCount            Int       @default(0) @map("line_count")
  includedCount        Int       @default(0) @map("included_count")
  /// JSON string array of posted journal entry ids
  journalEntryIdsJson  String?   @map("journal_entry_ids_json") @db.Text
  notes                String?   @db.Text
  previewedAt          DateTime? @map("previewed_at")
  approvedAt           DateTime? @map("approved_at")
  approvedById         String?   @map("approved_by_id")
  postedAt             DateTime? @map("posted_at")
  postedById           String?   @map("posted_by_id")
  reversedAt           DateTime? @map("reversed_at")
  reversedById         String?   @map("reversed_by_id")
  createdById          String?   @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  business Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  book     AssetDepreciationBook     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  lines    AssetDepreciationRunLine[]

  @@unique([businessId, runNumber])
  @@index([businessId, periodLabel])
  @@index([businessId, status])
  @@map("asset_depreciation_runs")
}

model AssetDepreciationRunLine {
  id                 String   @id
  businessId         String   @map("business_id")
  runId              String   @map("run_id")
  assetId            String   @map("asset_id")
  branchId           String?  @map("branch_id")
  method             String
  costBasis          Decimal  @map("cost_basis") @db.Decimal(18, 4)
  openingAccum       Decimal  @map("opening_accum") @db.Decimal(18, 4)
  openingNbv         Decimal  @map("opening_nbv") @db.Decimal(18, 4)
  residual           Decimal  @default(0) @db.Decimal(18, 4)
  /// Units of production actual units for this period (nullable for other methods)
  unitsActual        Decimal? @map("units_actual") @db.Decimal(18, 4)
  amount             Decimal  @db.Decimal(18, 4)
  /// included | skipped
  lineStatus         String   @default("included") @map("line_status")
  exceptionReason    String?  @map("exception_reason") @db.Text
  depreciationEntryId String? @map("depreciation_entry_id")
  createdAt          DateTime @default(now()) @map("created_at")

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  run      AssetDepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset    FixedAsset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([runId, assetId])
  @@index([businessId, runId])
  @@index([assetId])
  @@map("asset_depreciation_run_lines")
}

model DepreciationEntry {
  id             String   @id
  businessId     String   @map("business_id")
  assetId        String   @map("asset_id")
  /// Optional Phase 3 book (defaults to financial when null — historical rows)
  bookCode       String   @default("financial") @map("book_code")
  runId          String?  @map("run_id")
  runLineId      String?  @map("run_line_id")
  periodLabel    String   @map("period_label")
  runDate        DateTime @default(now()) @map("run_date")
  amount         Decimal  @db.Decimal(18, 4)
  journalEntryId String?  @map("journal_entry_id")
  /// posted | reversed
  status         String   @default("posted")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, bookCode, periodLabel], map: "depreciation_entries_asset_book_period_key")
  @@index([businessId])
  @@index([runId])
  @@map("depreciation_entries")
}

model Budget {
  id          String   @id
  businessId  String   @map("business_id")
  branchId    String?  @map("branch_id")
  name        String
  fiscalYear  Int      @map("fiscal_year")
  /// draft | active | closed
  status      String   @default("draft")
  notes       String?  @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines    BudgetLine[]

  @@index([businessId, fiscalYear])
  @@index([branchId])
  @@map("budgets")
}

model BudgetLine {
  id              String  @id
  budgetId        String  @map("budget_id")
  accountId       String  @map("account_id")
  /// CapEx / asset budgets: tie line to an asset category (actuals = capitalised spend)
  assetCategoryId String? @map("asset_category_id")
  /// 0 = annual total; 1-12 = month
  periodNo        Int     @default(0) @map("period_no")
  amount          Decimal @db.Decimal(18, 4)

  budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [accountId], references: [id])
  assetCategory AssetCategory? @relation(fields: [assetCategoryId], references: [id], onDelete: SetNull)

  /// Include category so CapEx lines can share a cost account across categories
  @@unique([budgetId, accountId, periodNo, assetCategoryId], map: "budget_lines_cat_uniq")
  @@index([budgetId])
  @@index([assetCategoryId])
  @@map("budget_lines")
}

// --- Phase 7: HR / Attendance / Payroll --------------------------------------

model Employee {
  id           String    @id
  businessId   String    @map("business_id")
  /// Home / HR branch. Transaction branch for postings is session active branch, not this field.
  branchId     String    @map("branch_id")
  /// Login account for this employee (required).
  userId       String    @unique @map("user_id")
  code         String?
  fullName     String    @map("full_name")
  email        String?
  phone        String?
  department   String?
  jobTitle     String?   @map("job_title")
  hireDate     DateTime? @map("hire_date")
  /// Fallback basic when no chart/package primary amount
  baseSalary   Decimal   @default(0) @map("base_salary") @db.Decimal(18, 4)
  /// monthly | biweekly | weekly
  payFrequency String    @default("monthly") @map("pay_frequency")
  payGradeId   String?   @map("pay_grade_id")
  payStep      Int?      @map("pay_step")
  /// permanent | contract | casual | intern
  employmentType String  @default("permanent") @map("employment_type")
  /// When true, sales_commission components pull accrued commissions into payroll
  includeSalesCommission Boolean @default(true) @map("include_sales_commission")
  bankName     String?   @map("bank_name")
  bankAccount  String?   @map("bank_account")
  taxId        String?   @map("tax_id")
  pensionId    String?   @map("pension_id")
  status       String    @default("active")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  payGrade       PayGrade?               @relation(fields: [payGradeId], references: [id], onDelete: SetNull)
  salesRep       SalesRep?
  attendance     AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  payrollItems   PayrollItem[]
  payPackageLines EmployeePayPackageLine[]
  payOverrides   EmployeePayOverride[]
  vehiclesDriven Vehicle[]
  custodiedAssets FixedAsset[] @relation("AssetCustodian")

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, branchId])
  @@index([payGradeId])
  @@map("employees")
}

model AttendanceRecord {
  id         String    @id
  businessId String    @map("business_id")
  employeeId String    @map("employee_id")
  workDate   DateTime  @map("work_date")
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")
  /// present | absent | leave | half_day
  status     String    @default("present")
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([businessId, workDate])
  @@map("attendance_records")
}

model LeaveRequest {
  id           String   @id
  businessId   String   @map("business_id")
  employeeId   String   @map("employee_id")
  leaveType    String   @default("annual") @map("leave_type")
  startsOn     DateTime @map("starts_on")
  endsOn       DateTime @map("ends_on")
  days         Decimal  @default(1) @db.Decimal(8, 2)
  reason       String?  @db.Text
  /// pending | approved | rejected | cancelled
  status       String   @default("pending")
  approvedById String?  @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("leave_requests")
}

/// Configurable salary / deduction / employer component definition (business-scoped).
model SalaryComponent {
  id                   String   @id
  businessId           String   @map("business_id")
  code                 String
  name                 String
  shortName            String?  @map("short_name")
  /// earning | deduction | employer_contribution
  type                 String
  /// fixed | percent_of_components | progressive_tax | statutory_rate | sales_commission
  calculationMethod    String   @default("fixed") @map("calculation_method")
  isTaxable            Boolean  @default(false) @map("is_taxable")
  isPensionable        Boolean  @default(false) @map("is_pensionable")
  isStatutory          Boolean  @default(false) @map("is_statutory")
  /// Marks the primary basic salary component
  isPrimary            Boolean  @default(false) @map("is_primary")
  /// For percent_of_components / progressive_tax base: JSON array of component codes
  functionElements     Json?    @map("function_elements")
  functionPercentage   Decimal? @map("function_percentage") @db.Decimal(14, 4)
  /// Links to PayrollStatutoryRule.key for statutory_rate / progressive_tax
  statutoryKey         String?  @map("statutory_key")
  accountId            String?  @map("account_id")
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdById          String?  @map("created_by_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account           Account?                 @relation("SalaryComponentAccount", fields: [accountId], references: [id], onDelete: SetNull)
  chartEntries      SalaryChartEntry[]
  packageLines      EmployeePayPackageLine[]
  overrides         EmployeePayOverride[]
  payrollItemLines  PayrollItemLine[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@index([businessId, type])
  @@map("salary_components")
}

model PayGrade {
  id          String   @id
  businessId  String   @map("business_id")
  code        String
  name        String
  maxStep     Int      @default(1) @map("max_step")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees    Employee[]
  chartEntries SalaryChartEntry[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("pay_grades")
}

model SalaryChartEntry {
  id             String   @id
  businessId     String   @map("business_id")
  payGradeId     String   @map("pay_grade_id")
  step           Int
  /// permanent | contract | casual | intern
  employmentType String   @default("permanent") @map("employment_type")
  componentId    String   @map("component_id")
  amount         Decimal  @db.Decimal(18, 4)
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payGrade  PayGrade         @relation(fields: [payGradeId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([payGradeId, step, employmentType, componentId])
  @@index([businessId])
  @@index([componentId])
  @@map("salary_chart_entries")
}

/// Direct per-employee package amounts (alternative / supplement to grade chart).
model EmployeePayPackageLine {
  id          String   @id
  businessId  String   @map("business_id")
  employeeId  String   @map("employee_id")
  componentId String   @map("component_id")
  amount      Decimal  @db.Decimal(18, 4)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, componentId])
  @@index([businessId])
  @@map("employee_pay_package_lines")
}

model EmployeePayOverride {
  id               String    @id
  businessId       String    @map("business_id")
  employeeId       String    @map("employee_id")
  componentId      String    @map("component_id")
  amount           Decimal   @db.Decimal(18, 4)
  /// Continuous overrides apply every period; one-time depletes toward targetAmount
  isContinuous     Boolean   @default(true) @map("is_continuous")
  targetAmount     Decimal?  @map("target_amount") @db.Decimal(18, 4)
  balanceRemaining Decimal?  @map("balance_remaining") @db.Decimal(18, 4)
  effectiveFrom    DateTime? @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?   @db.Text
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([businessId, employeeId])
  @@index([componentId])
  @@map("employee_pay_overrides")
}

model PayrollStatutoryRule {
  id          String   @id
  businessId  String   @map("business_id")
  /// paye | pension_employee | pension_employer | nhf | custom
  key         String
  name        String
  /// progressive_brackets | flat_rate
  method      String
  /// For flat_rate: percentage (e.g. 8 = 8%)
  rate        Decimal? @db.Decimal(14, 4)
  /// pensionable | taxable | gross | custom
  baseKey     String?  @map("base_key")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brackets PayrollTaxBracket[]

  @@unique([businessId, key])
  @@index([businessId, isActive])
  @@map("payroll_statutory_rules")
}

model PayrollTaxBracket {
  id        String   @id
  ruleId    String   @map("rule_id")
  sortOrder Int      @default(0) @map("sort_order")
  /// Upper bound of band (annual); null = open-ended
  upperLimit Decimal? @map("upper_limit") @db.Decimal(18, 4)
  rate      Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rule PayrollStatutoryRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("payroll_tax_brackets")
}

model ActivePayrollPeriod {
  id         String   @id
  businessId String   @unique @map("business_id")
  year       Int
  month      Int
  updatedById String? @map("updated_by_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("active_payroll_periods")
}

model PayrollRun {
  id                    String    @id
  businessId            String    @map("business_id")
  branchId              String?   @map("branch_id")
  runNumber             String    @map("run_number")
  periodStart           DateTime  @map("period_start")
  periodEnd             DateTime  @map("period_end")
  payDate               DateTime  @map("pay_date")
  year                  Int?
  month                 Int?
  /// draft | approved | posted | paid | void
  status                String    @default("draft")
  totalGross            Decimal   @default(0) @map("total_gross") @db.Decimal(18, 4)
  totalDeductions       Decimal   @default(0) @map("total_deductions") @db.Decimal(18, 4)
  totalNet              Decimal   @default(0) @map("total_net") @db.Decimal(18, 4)
  totalCommission       Decimal   @default(0) @map("total_commission") @db.Decimal(18, 4)
  journalEntryId        String?   @map("journal_entry_id")
  paymentJournalEntryId String?   @map("payment_journal_entry_id")
  approvedAt            DateTime? @map("approved_at")
  approvedById          String?   @map("approved_by_id")
  postedAt              DateTime? @map("posted_at")
  postedById            String?   @map("posted_by_id")
  notes                 String?   @db.Text
  createdById           String?   @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items    PayrollItem[]

  @@unique([businessId, runNumber])
  @@index([businessId, status])
  @@index([businessId, year, month])
  @@index([branchId])
  @@map("payroll_runs")
}

model PayrollItem {
  id              String  @id
  payrollRunId    String  @map("payroll_run_id")
  employeeId      String  @map("employee_id")
  basicSalary     Decimal @map("basic_salary") @db.Decimal(18, 4)
  allowances      Decimal @default(0) @db.Decimal(18, 4)
  deductions      Decimal @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  pensionEmployee Decimal @default(0) @map("pension_employee") @db.Decimal(18, 4)
  pensionEmployer Decimal @default(0) @map("pension_employer") @db.Decimal(18, 4)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(18, 4)
  netPay          Decimal @map("net_pay") @db.Decimal(18, 4)
  notes           String? @db.Text

  payrollRun      PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee           @relation(fields: [employeeId], references: [id])
  lines           PayrollItemLine[]
  salesCommissions SalesCommission[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_items")
}

model PayrollItemLine {
  id                       String  @id
  payrollItemId            String  @map("payroll_item_id")
  componentId              String? @map("component_id")
  componentCode            String  @map("component_code")
  componentName            String  @map("component_name")
  /// earning | deduction | employer_contribution
  componentType            String  @map("component_type")
  calculationMethod        String  @map("calculation_method")
  amount                   Decimal @db.Decimal(18, 4)
  isEmployerContribution   Boolean @default(false) @map("is_employer_contribution")
  sortOrder                Int     @default(0) @map("sort_order")

  payrollItem PayrollItem      @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  component   SalaryComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([payrollItemId])
  @@index([componentId])
  @@map("payroll_item_lines")
}

// --- Phase 8: Distribution / Logistics / Delivery ----------------------------

model Vehicle {
  id               String   @id
  businessId       String   @map("business_id")
  code             String?
  name             String
  plateNumber      String?  @map("plate_number")
  capacity         Decimal? @db.Decimal(18, 2)
  driverEmployeeId String?  @map("driver_employee_id")
  status           String   @default("available")
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  driver     Employee?       @relation(fields: [driverEmployeeId], references: [id], onDelete: SetNull)
  deliveries DeliveryOrder[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("vehicles")
}

model DeliveryOrder {
  id             String    @id
  businessId     String    @map("business_id")
  deliveryNumber String    @map("delivery_number")
  salesInvoiceId String?   @map("sales_invoice_id")
  customerId     String    @map("customer_id")
  warehouseId    String    @map("warehouse_id")
  branchId       String?   @map("branch_id")
  vehicleId      String?   @map("vehicle_id")
  driverName     String?   @map("driver_name")
  scheduledDate  DateTime? @map("scheduled_date")
  dispatchedAt   DateTime? @map("dispatched_at")
  deliveredAt    DateTime? @map("delivered_at")
  /// draft | scheduled | dispatched | delivered | cancelled
  status         String    @default("draft")
  addressLine1   String?   @map("address_line1")
  city           String?
  notes          String?   @db.Text
  /// Warehouse fulfilment this delivery carries (sales orders in delivery mode); delivering it posts the sale
  fulfilmentId   String?   @unique @map("fulfilment_id")
  /// Proof of delivery
  receivedBy     String?   @map("received_by")
  podReference   String?   @map("pod_reference")
  podNotes       String?   @map("pod_notes") @db.Text
  deliveredById  String?   @map("delivered_by_id")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice?       @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  fulfilment   SalesFulfilment?    @relation(fields: [fulfilmentId], references: [id], onDelete: SetNull)
  customer     Customer            @relation(fields: [customerId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  items        DeliveryOrderItem[]

  @@unique([businessId, deliveryNumber])
  @@index([businessId, status])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id              String  @id
  deliveryOrderId String  @map("delivery_order_id")
  productId       String  @map("product_id")
  variantId       String? @map("variant_id")
  quantity        Decimal @db.Decimal(18, 4)
  notes           String? @db.Text

  deliveryOrder DeliveryOrder   @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([deliveryOrderId])
  @@map("delivery_order_items")
}

// --- Phase 9: Notifications (BI/SaaS reuse existing tables) -------------------

model AppNotification {
  id         String   @id
  businessId String   @map("business_id")
  userId     String?  @map("user_id")
  title      String
  body       String   @db.Text
  module     String?
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, isRead])
  @@index([createdAt])
  @@map("app_notifications")
}

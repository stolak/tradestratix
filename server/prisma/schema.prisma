generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── SaaS / Platform ─────────────────────────────────────────────────────────

model SubscriptionPlan {
  id            String                 @id
  code          String                 @unique
  name          String
  description   String?                @db.Text
  monthlyPrice  Decimal                @default(0) @map("monthly_price") @db.Decimal(18, 2)
  yearlyPrice   Decimal                @default(0) @map("yearly_price") @db.Decimal(18, 2)
  maxUsers      Int                    @default(5) @map("max_users")
  maxBranches   Int                    @default(1) @map("max_branches")
  maxWarehouses Int                    @default(2) @map("max_warehouses")
  modulesJson   String                 @map("modules_json") @db.Text
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  subscriptions BusinessSubscription[]

  @@map("subscription_plans")
}

model BusinessSubscription {
  id          String           @id
  businessId  String           @map("business_id")
  planId      String           @map("plan_id")
  status      String           @default("trial")
  startsAt    DateTime         @map("starts_at")
  endsAt      DateTime?        @map("ends_at")
  trialEndsAt DateTime?        @map("trial_ends_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([businessId])
  @@map("business_subscriptions")
}

// ─── Tenant / Organisation ───────────────────────────────────────────────────

model Business {
  id                   String   @id
  name                 String
  legalName            String?  @map("legal_name")
  registrationNumber   String?  @map("registration_number")
  taxId                String?  @map("tax_id")
  email                String?
  phone                String?
  addressLine1         String?  @map("address_line1")
  addressLine2         String?  @map("address_line2")
  city                 String?
  state                String?
  country              String?  @default("NG")
  postalCode           String?  @map("postal_code")
  logoUrl              String?  @map("logo_url") @db.Text
  /// distributor | wholesaler | retailer | distributor_retailer | hybrid
  businessType         String   @default("hybrid") @map("business_type")
  defaultCurrency      String   @default("NGN") @map("default_currency")
  /// fifo | weighted_average | specific_identification
  inventoryValuation   String   @default("weighted_average") @map("inventory_valuation")
  timezone             String   @default("Africa/Lagos")
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  enabledModulesJson   String?  @map("enabled_modules_json") @db.Text
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdById          String?  @map("created_by_id")
  updatedById          String?  @map("updated_by_id")

  settings               BusinessSetting[]
  subscriptions          BusinessSubscription[]
  branches               Branch[]
  warehouses             Warehouse[]
  users                  User[]
  userBranches           UserBranch[]
  userWarehouses         UserWarehouse[]
  roles                  Role[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  defaultAccountSettings DefaultAccountSetting[]
  financialYears         FinancialYear[]
  accountingPeriods      AccountingPeriod[]
  auditLogs              AuditLog[]
  menus                  Menu[]
  currencies             BusinessCurrency[]
  productCategories      ProductCategory[]
  brands                 Brand[]
  unitsOfMeasure         UnitOfMeasure[]
  products               Product[]
  productVariants        ProductVariant[]
  stockLots              StockLot[]
  stockMovements         StockMovement[]
  stockTransfers         StockTransfer[]
  productUnitConversions ProductUnitConversion[]
  productSellingPrices   ProductSellingPrice[]
  branchSellingPrices    BranchSellingPrice[]
  branchProductDiscounts BranchProductDiscount[]
  salesReservations      SalesReservation[]
  salesFulfilments       SalesFulfilment[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  goodsReceiptNotes      GoodsReceiptNote[]
  supplierBills          SupplierBill[]
  supplierPayments       SupplierPayment[]
  customers              Customer[]
  salesReps              SalesRep[]
  salesInvoices          SalesInvoice[]
  customerPayments       CustomerPayment[]
  salesCommissions       SalesCommission[]
  bankAccounts           BankAccount[]
  bankTransactions       BankTransaction[]
  expenseBills           ExpenseBill[]
  fixedAssets            FixedAsset[]
  depreciationEntries    DepreciationEntry[]
  budgets                Budget[]
  employees              Employee[]
  attendanceRecords      AttendanceRecord[]
  leaveRequests          LeaveRequest[]
  payrollRuns            PayrollRun[]
  vehicles               Vehicle[]
  deliveryOrders         DeliveryOrder[]
  notifications          AppNotification[]

  @@map("businesses")
}

model BusinessSetting {
  id         String   @id
  businessId String   @map("business_id")
  settingKey String   @map("setting_key")
  value      String   @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, settingKey])
  @@map("business_settings")
}

model BusinessCurrency {
  id           String   @id
  businessId   String   @map("business_id")
  code         String
  name         String
  symbol       String
  isDefault    Boolean  @default(false) @map("is_default")
  exchangeRate Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  isActive     Boolean  @default(true) @map("is_active")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@map("business_currencies")
}

model Branch {
  id               String             @id
  businessId       String             @map("business_id")
  name             String
  code             String
  email            String?
  phone            String?
  addressLine1     String?            @map("address_line1")
  city             String?
  state            String?
  country          String?
  managerUserId    String?            @map("manager_user_id")
  operatingHours   String?            @map("operating_hours") @db.Text
  salesTarget      Decimal?           @map("sales_target") @db.Decimal(18, 2)
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  createdById      String?            @map("created_by_id")
  updatedById      String?            @map("updated_by_id")
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses       Warehouse[]
  userBranches     UserBranch[]
  usersDefault     User[]             @relation("UserDefaultBranch")
  journalEntries   JournalEntry[]
  salesInvoices    SalesInvoice[]     @relation("InvoiceRevenueBranch")
  salesInvoicesSold SalesInvoice[]    @relation("InvoiceSellingBranch")
  salesFulfilments SalesFulfilment[]
  fixedAssets      FixedAsset[]
  employees        Employee[]
  deliveryOrders   DeliveryOrder[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceiptNote[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]
  customerPayments CustomerPayment[]
  salesCommissions SalesCommission[]
  expenseBills     ExpenseBill[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  stockMovements   StockMovement[]
  transfersFrom    StockTransfer[]    @relation("TransferFromBranch")
  transfersTo      StockTransfer[]    @relation("TransferToBranch")
  payrollRuns      PayrollRun[]
  budgets          Budget[]
  auditLogs        AuditLog[]
  sellingPriceOverrides BranchSellingPrice[]
  productDiscounts      BranchProductDiscount[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
  @@map("branches")
}

model Warehouse {
  id             String             @id
  businessId     String             @map("business_id")
  branchId       String             @map("branch_id")
  name           String
  code           String
  /// main | retail | damaged | quarantine | other
  category       String             @default("main")
  managerUserId  String?            @map("manager_user_id")
  capacity       Decimal?           @db.Decimal(18, 2)
  addressLine1   String?            @map("address_line1")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  createdById    String?            @map("created_by_id")
  updatedById    String?            @map("updated_by_id")
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockLots      StockLot[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[]    @relation("TransferFrom")
  transfersTo    StockTransfer[]    @relation("TransferTo")
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceiptNote[]
  salesInvoices  SalesInvoice[]
  deliveryOrders DeliveryOrder[]
  userWarehouses UserWarehouse[]
  fulfilmentLines SalesInvoiceItem[]
  salesReservations SalesReservation[]
  salesFulfilments SalesFulfilment[]

  @@unique([businessId, code])
  @@index([branchId])
  @@map("warehouses")
}

// ─── Identity & RBAC ─────────────────────────────────────────────────────────

model User {
  id              String    @id
  businessId      String    @map("business_id")
  username        String
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name")
  /// Primary role code for JWT convenience
  role            String
  email           String?
  phone           String?
  department      String?
  avatarUrl       String?   @map("avatar_url") @db.Text
  defaultBranchId String?   @map("default_branch_id")
  status          String    @default("active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdById     String?   @map("created_by_id")
  updatedById     String?   @map("updated_by_id")

  business            Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultBranch       Branch?                  @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  userBranches        UserBranch[]
  userWarehouses      UserWarehouse[]
  loginHistory        LoginHistory[]
  refreshTokens       RefreshToken[]
  employees           Employee[]
  notifications       AppNotification[]

  @@unique([businessId, username])
  @@index([businessId])
  @@map("users")
}

model Role {
  id              String           @id
  businessId      String?          @map("business_id")
  code            String
  name            String
  description     String?          @db.Text
  isSystem        Boolean          @default(false) @map("is_system")
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  roleMenus       RoleMenu[]

  @@unique([businessId, code])
  @@map("roles")
}

model Permission {
  id              String                   @id
  code            String                   @unique
  name            String
  description     String?                  @db.Text
  module          String
  action          String
  isActive        Boolean                  @default(true) @map("is_active")
  sortOrder       Int                      @default(0) @map("sort_order")
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model Menu {
  id         String     @id
  businessId String?    @map("business_id")
  code       String
  name       String
  route      String?
  icon       String?
  section    String?
  parentId   String?    @map("parent_id")
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  business   Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Menu[]     @relation("MenuTree")
  roleMenus  RoleMenu[]

  @@unique([businessId, code])
  @@map("menus")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleMenu {
  roleId String @map("role_id")
  menuId String @map("menu_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}

model UserPermissionOverride {
  id           String     @id
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  /// grant | deny
  effect       String
  createdById  String?    @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model UserBranch {
  userId       String   @map("user_id")
  businessId   String   @map("business_id")
  branchId     String   @map("branch_id")
  /// Optional branch-specific role code (e.g. sales_manager)
  roleCode     String?  @map("role_code")
  /// active | revoked
  status       String   @default("active")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([businessId, userId])
  @@index([branchId, status])
  @@map("user_branches")
}

model UserWarehouse {
  userId       String    @map("user_id")
  businessId   String    @map("business_id")
  warehouseId  String    @map("warehouse_id")
  /// active | revoked
  status       String    @default("active")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedById String?   @map("assigned_by_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([businessId, userId])
  @@index([warehouseId, status])
  @@map("user_warehouses")
}

model LoginHistory {
  id        String   @id
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_history")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Accounting ──────────────────────────────────────────────────────────────

model Account {
  id               String                  @id
  businessId       String                  @map("business_id")
  code             String
  name             String
  /// asset | liability | equity | revenue | expense | cogs
  accountType      String                  @map("account_type")
  parentId         String?                 @map("parent_id")
  isActive         Boolean                 @default(true) @map("is_active")
  isSystem         Boolean                 @default(false) @map("is_system")
  description      String?                 @db.Text
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent           Account?                @relation("AccountTree", fields: [parentId], references: [id])
  children         Account[]               @relation("AccountTree")
  journalLines     JournalLine[]
  defaultSettings  DefaultAccountSetting[]
  supplierPayments SupplierPayment[]
  customerPayments CustomerPayment[]
  bankAccounts     BankAccount[]
  bankTxnOffsets   BankTransaction[]       @relation("BankTxnOffsetAccount")
  expenseLines     ExpenseBillLine[]
  budgetLines      BudgetLine[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("accounts")
}

model JournalEntry {
  id                      String         @id
  businessId              String         @map("business_id")
  branchId                String?        @map("branch_id")
  /// Primary customer for AR / customer-facing journals (nullable)
  customerId              String?        @map("customer_id")
  /// Primary supplier for AP / supplier-facing journals (nullable)
  supplierId              String?        @map("supplier_id")
  /// Commercial sales representative responsible (not the posting user)
  salesRepresentativeId   String?        @map("sales_representative_id")
  entryNumber             String         @map("entry_number")
  entryDate               DateTime       @map("entry_date")
  memo                    String?        @db.Text
  /// draft | posted | reversed
  status                  String         @default("draft")
  sourceType              String?        @map("source_type")
  sourceId                String?        @map("source_id")
  idempotencyKey          String?        @map("idempotency_key")
  currencyCode            String         @default("NGN") @map("currency_code")
  postedAt                DateTime?      @map("posted_at")
  postedById              String?        @map("posted_by_id")
  reversedByEntryId       String?        @map("reversed_by_entry_id")
  createdById             String?        @map("created_by_id")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  business                Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                  Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer                Customer?      @relation("JournalCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  supplier                Supplier?      @relation("JournalSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  salesRepresentative     SalesRep?      @relation("JournalSalesRep", fields: [salesRepresentativeId], references: [id], onDelete: Restrict)
  lines                   JournalLine[]
  reversedBy              JournalEntry?  @relation("JournalReversal", fields: [reversedByEntryId], references: [id])
  reverses                JournalEntry[] @relation("JournalReversal")

  @@unique([businessId, entryNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, sourceType, sourceId])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@index([businessId, salesRepresentativeId])
  @@index([entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id
  journalEntryId String       @map("journal_entry_id")
  accountId      String       @map("account_id")
  description    String?      @db.Text
  debit          Decimal      @default(0) @db.Decimal(18, 4)
  credit         Decimal      @default(0) @db.Decimal(18, 4)
  lineNo         Int          @map("line_no")
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model DefaultAccountSetting {
  id          String   @id
  businessId  String   @map("business_id")
  settingKey  String   @map("setting_key")
  accountId   String   @map("account_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id])
  description String?  @map("description")

  @@unique([businessId, settingKey])
  @@map("default_account_settings")
}

model FinancialYear {
  id         String             @id
  businessId String             @map("business_id")
  name       String
  startsOn   DateTime           @map("starts_on")
  endsOn     DateTime           @map("ends_on")
  isClosed   Boolean            @default(false) @map("is_closed")
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periods    AccountingPeriod[]

  @@index([businessId])
  @@map("financial_years")
}

model AccountingPeriod {
  id              String        @id
  businessId      String        @map("business_id")
  financialYearId String        @map("financial_year_id")
  name            String
  periodNo        Int           @map("period_no")
  startsOn        DateTime      @map("starts_on")
  endsOn          DateTime      @map("ends_on")
  isLocked        Boolean       @default(false) @map("is_locked")
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@unique([financialYearId, periodNo])
  @@map("accounting_periods")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id         String    @id
  businessId String?   @map("business_id")
  branchId   String?   @map("branch_id")
  userId     String?   @map("user_id")
  action     String
  module     String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  summary    String?   @db.Text
  metadata   String?   @db.LongText
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@index([module])
  @@map("audit_logs")
}

// ─── Phase 2: Products & Inventory ───────────────────────────────────────────

model ProductCategory {
  id          String            @id
  businessId  String            @map("business_id")
  parentId    String?           @map("parent_id")
  name        String
  code        String?
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("product_categories")
}

model Brand {
  id         String    @id
  businessId String    @map("business_id")
  name       String
  code       String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, name])
  @@map("brands")
}

model UnitOfMeasure {
  id                 String                  @id
  businessId         String                  @map("business_id")
  code               String
  name               String
  /// Count | Volume | Weight | Length | Packaging
  unitCategory       String                  @default("Count") @map("unit_category")
  allowsDecimal      Boolean                 @default(false) @map("allows_decimal")
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productsBase       Product[]               @relation("ProductBaseUom")
  productsPurchase   Product[]               @relation("ProductPurchaseUom")
  productsSelling    Product[]               @relation("ProductSellingUom")
  conversionsFrom    ProductUnitConversion[] @relation("ConversionFrom")
  conversionsTo      ProductUnitConversion[] @relation("ConversionTo")
  stockMovements     StockMovement[]
  sellingPrices      ProductSellingPrice[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesInvoiceItems  SalesInvoiceItem[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("units_of_measure")
}

model Product {
  id                  String   @id
  businessId          String   @map("business_id")
  name                String
  productCode         String?  @map("product_code")
  sku                 String?
  barcode             String?
  description         String?  @db.Text
  categoryId          String?  @map("category_id")
  brandId             String?  @map("brand_id")
  manufacturer        String?
  imageUrl            String?  @map("image_url") @db.Text
  status              String   @default("active")
  /// Derived summary of enabled tracking flags (e.g. expiry+batch+weight)
  trackingMode        String   @default("standard") @map("tracking_mode")
  trackBatch          Boolean  @default(false) @map("track_batch")
  trackExpiry         Boolean  @default(false) @map("track_expiry")
  trackSerial         Boolean  @default(false) @map("track_serial")
  trackWeight         Boolean  @default(false) @map("track_weight")
  trackLength         Boolean  @default(false) @map("track_length")
  hasVariants         Boolean  @default(false) @map("has_variants")
  baseUomId           String   @map("base_uom_id")
  purchaseUomId       String?  @map("purchase_uom_id")
  sellingUomId        String?  @map("selling_uom_id")
  reorderLevel        Decimal  @default(0) @map("reorder_level") @db.Decimal(18, 4)
  minStock            Decimal  @default(0) @map("min_stock") @db.Decimal(18, 4)
  maxStock            Decimal? @map("max_stock") @db.Decimal(18, 4)
  defaultPurchaseCost Decimal  @default(0) @map("default_purchase_cost") @db.Decimal(18, 4)
  defaultSellingPrice Decimal  @default(0) @map("default_selling_price") @db.Decimal(18, 4)
  distributorPrice    Decimal? @map("distributor_price") @db.Decimal(18, 4)
  wholesalePrice      Decimal? @map("wholesale_price") @db.Decimal(18, 4)
  retailPrice         Decimal? @map("retail_price") @db.Decimal(18, 4)
  taxCategory         String?  @map("tax_category")
  expiryAlertDaysJson String?  @map("expiry_alert_days_json") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdById         String?  @map("created_by_id")
  updatedById         String?  @map("updated_by_id")

  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseUom            UnitOfMeasure           @relation("ProductBaseUom", fields: [baseUomId], references: [id])
  purchaseUom        UnitOfMeasure?          @relation("ProductPurchaseUom", fields: [purchaseUomId], references: [id])
  sellingUom         UnitOfMeasure?          @relation("ProductSellingUom", fields: [sellingUomId], references: [id])
  variants           ProductVariant[]
  conversions        ProductUnitConversion[]
  sellingPrices      ProductSellingPrice[]
  branchDiscounts    BranchProductDiscount[]
  stockLots          StockLot[]
  stockMovements     StockMovement[]
  transferItems      StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesInvoiceItems  SalesInvoiceItem[]
  deliveryItems      DeliveryOrderItem[]

  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([status])
  @@map("products")
}

/// Selling price per configured product UoM (base or packaging conversion unit).
model ProductSellingPrice {
  id         String        @id
  businessId String        @map("business_id")
  productId  String        @map("product_id")
  uomId      String        @map("uom_id")
  /// retail | wholesale | distributor | special | custom
  priceLevel String        @default("retail") @map("price_level")
  label      String?
  unitPrice  Decimal       @map("unit_price") @db.Decimal(18, 4)
  minQty     Decimal       @default(1) @map("min_qty") @db.Decimal(18, 4)
  isDefault  Boolean       @default(false) @map("is_default")
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom        UnitOfMeasure @relation(fields: [uomId], references: [id])
  branchOverrides BranchSellingPrice[]

  @@unique([productId, uomId, priceLevel])
  @@index([productId])
  @@map("product_selling_prices")
}

/// Branch-specific override of a global ProductSellingPrice row.
/// When absent (or inactive) the branch sells at the global price.
model BranchSellingPrice {
  id             String              @id
  businessId     String              @map("business_id")
  branchId       String              @map("branch_id")
  sellingPriceId String              @map("selling_price_id")
  unitPrice      Decimal             @map("unit_price") @db.Decimal(18, 4)
  isActive       Boolean             @default(true) @map("is_active")
  createdById    String?             @map("created_by_id")
  updatedById    String?             @map("updated_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sellingPrice   ProductSellingPrice @relation(fields: [sellingPriceId], references: [id], onDelete: Cascade)

  @@unique([branchId, sellingPriceId])
  @@index([businessId, branchId])
  @@map("branch_selling_prices")
}

/// Branch-specific % discount on a product, applied to every UoM / price level
/// after any branch price override.
model BranchProductDiscount {
  id              String   @id
  businessId      String   @map("business_id")
  branchId        String   @map("branch_id")
  productId       String   @map("product_id")
  discountPercent Decimal  @map("discount_percent") @db.Decimal(8, 4)
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String?  @map("created_by_id")
  updatedById     String?  @map("updated_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([businessId, branchId])
  @@map("branch_product_discounts")
}

model ProductVariant {
  id                 String              @id
  businessId         String              @map("business_id")
  productId          String              @map("product_id")
  name               String
  sku                String?
  barcode            String?
  size               String?
  colour             String?
  attributesJson     String?             @map("attributes_json") @db.Text
  purchaseCost       Decimal?            @map("purchase_cost") @db.Decimal(18, 4)
  sellingPrice       Decimal?            @map("selling_price") @db.Decimal(18, 4)
  isDefault          Boolean             @default(false) @map("is_default")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLots          StockLot[]
  stockMovements     StockMovement[]
  transferItems      StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesInvoiceItems  SalesInvoiceItem[]
  deliveryItems      DeliveryOrderItem[]

  @@unique([businessId, sku])
  @@index([productId])
  @@map("product_variants")
}

/// Conversion into base UoM: 1 fromUom = factor base units (via chain if needed).
model ProductUnitConversion {
  id         String        @id
  businessId String        @map("business_id")
  productId  String        @map("product_id")
  fromUomId  String        @map("from_uom_id")
  toUomId    String        @map("to_uom_id")
  factor     Decimal       @db.Decimal(18, 6)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUom    UnitOfMeasure @relation("ConversionFrom", fields: [fromUomId], references: [id])
  toUom      UnitOfMeasure @relation("ConversionTo", fields: [toUomId], references: [id])

  @@unique([productId, fromUomId, toUomId])
  @@map("product_unit_conversions")
}

model StockLot {
  id                String              @id
  businessId        String              @map("business_id")
  productId         String              @map("product_id")
  variantId         String              @map("variant_id")
  warehouseId       String              @map("warehouse_id")
  lotKey            String              @map("lot_key")
  batchNumber       String              @default("BULK") @map("batch_number")
  manufacturingDate String?             @map("manufacturing_date")
  expiryDate        String?             @map("expiry_date")
  quantityOnHand    Decimal             @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  quantityReserved  Decimal             @default(0) @map("quantity_reserved") @db.Decimal(18, 4)
  quantityInTransit Decimal             @default(0) @map("quantity_in_transit") @db.Decimal(18, 4)
  unitCost          Decimal?            @map("unit_cost") @db.Decimal(18, 4)
  /// available | quarantine | recalled | expired
  status            String              @default("available")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id])
  variant           ProductVariant      @relation(fields: [variantId], references: [id])
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  movements         StockMovement[]
  transferItems     StockTransferItem[]
  salesReservations SalesReservation[]

  @@unique([businessId, lotKey])
  @@index([variantId, warehouseId])
  @@index([expiryDate])
  @@map("stock_lots")
}

model StockMovement {
  id                  String         @id
  businessId          String         @map("business_id")
  branchId            String?        @map("branch_id")
  productId           String         @map("product_id")
  variantId           String         @map("variant_id")
  warehouseId         String         @map("warehouse_id")
  lotId               String?        @map("lot_id")
  /// receive | issue | adjust_in | adjust_out | transfer_out | transfer_in | opening | write_off | return_in | return_out
  movementType        String         @map("movement_type")
  quantityIn          Decimal        @default(0) @map("quantity_in") @db.Decimal(18, 4)
  quantityOut         Decimal        @default(0) @map("quantity_out") @db.Decimal(18, 4)
  transactionQuantity Decimal?       @map("transaction_quantity") @db.Decimal(18, 4)
  transactionUomId    String?        @map("transaction_uom_id")
  unitCost            Decimal?       @map("unit_cost") @db.Decimal(18, 4)
  totalCost           Decimal?       @map("total_cost") @db.Decimal(18, 4)
  referenceType       String?        @map("reference_type")
  referenceId         String?        @map("reference_id")
  batchNumber         String?        @map("batch_number")
  expiryDate          String?        @map("expiry_date")
  reason              String?        @db.Text
  performedById       String?        @map("performed_by_id")
  performedByName     String?        @map("performed_by_name")
  idempotencyKey      String?        @map("idempotency_key")
  status              String         @default("completed")
  createdAt           DateTime       @default(now()) @map("created_at")
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product             Product        @relation(fields: [productId], references: [id])
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  warehouse           Warehouse      @relation(fields: [warehouseId], references: [id])
  lot                 StockLot?      @relation(fields: [lotId], references: [id])
  transactionUom      UnitOfMeasure? @relation(fields: [transactionUomId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([productId, createdAt])
  @@index([warehouseId])
  @@index([branchId])
  @@index([lotId])
  @@map("stock_movements")
}

model StockTransfer {
  id              String              @id
  businessId      String              @map("business_id")
  transferNumber  String              @map("transfer_number")
  fromWarehouseId String              @map("from_warehouse_id")
  toWarehouseId   String              @map("to_warehouse_id")
  fromBranchId    String?             @map("from_branch_id")
  toBranchId      String?             @map("to_branch_id")
  /// draft | pending_approval | approved | in_transit | received | rejected | cancelled
  status          String              @default("draft")
  notes           String?             @db.Text
  requestedById   String?             @map("requested_by_id")
  approvedById    String?             @map("approved_by_id")
  dispatchedAt    DateTime?           @map("dispatched_at")
  receivedAt      DateTime?           @map("received_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  fromBranch      Branch?             @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch        Branch?             @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)
  items           StockTransferItem[]

  @@unique([businessId, transferNumber])
  @@index([status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id            String         @id
  transferId    String         @map("transfer_id")
  productId     String         @map("product_id")
  variantId     String         @map("variant_id")
  fromLotId     String?        @map("from_lot_id")
  quantity      Decimal        @db.Decimal(18, 4)
  batchNumber   String?        @map("batch_number")
  expiryDate    String?        @map("expiry_date")
  outMovementId String?        @map("out_movement_id")
  inMovementId  String?        @map("in_movement_id")
  transfer      StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  fromLot       StockLot?      @relation(fields: [fromLotId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ─── Phase 3: Suppliers / Procurement / AP ───────────────────────────────────

model Supplier {
  id               String   @id
  businessId       String   @map("business_id")
  code             String?
  name             String
  contactPerson    String?  @map("contact_person")
  email            String?
  phone            String?
  addressLine1     String?  @map("address_line1")
  city             String?
  state            String?
  country          String?  @default("NG")
  taxId            String?  @map("tax_id")
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(18, 2)
  notes            String?  @db.Text
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdById      String?  @map("created_by_id")
  updatedById      String?  @map("updated_by_id")

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceiptNote[]
  bills          SupplierBill[]
  payments       SupplierPayment[]
  expenseBills   ExpenseBill[]
  journalEntries JournalEntry[]     @relation("JournalSupplier")

  @@unique([businessId, code])
  @@index([businessId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id
  businessId   String    @map("business_id")
  branchId     String?   @map("branch_id")
  supplierId   String    @map("supplier_id")
  warehouseId  String    @map("warehouse_id")
  poNumber     String    @map("po_number")
  /// draft | pending_approval | approved | partially_received | received | cancelled
  status       String    @default("draft")
  orderDate    DateTime  @default(now()) @map("order_date")
  expectedDate DateTime? @map("expected_date")
  notes        String?   @db.Text
  subtotal     Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount    Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]
  receipts  GoodsReceiptNote[]

  @@unique([businessId, poNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id
  purchaseOrderId  String  @map("purchase_order_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  uomId            String? @map("uom_id")
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(18, 4)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(18, 4)
  unitCost         Decimal @map("unit_cost") @db.Decimal(18, 4)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 4)
  notes            String? @db.Text

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id])
  variant       ProductVariant?    @relation(fields: [variantId], references: [id])
  uom           UnitOfMeasure?     @relation(fields: [uomId], references: [id])
  receiptItems  GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceiptNote {
  id              String   @id
  businessId      String   @map("business_id")
  branchId        String?  @map("branch_id")
  supplierId      String   @map("supplier_id")
  purchaseOrderId String?  @map("purchase_order_id")
  warehouseId     String   @map("warehouse_id")
  grnNumber       String   @map("grn_number")
  /// draft | posted | cancelled
  status          String   @default("draft")
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?  @db.Text
  subtotal        Decimal  @default(0) @db.Decimal(18, 4)
  journalEntryId  String?  @map("journal_entry_id")
  billId          String?  @map("bill_id")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  items         GoodsReceiptItem[]
  bill          SupplierBill?

  @@unique([businessId, grnNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@map("goods_receipt_notes")
}

model GoodsReceiptItem {
  id                  String  @id
  grnId               String  @map("grn_id")
  purchaseOrderItemId String? @map("purchase_order_item_id")
  productId           String  @map("product_id")
  variantId           String? @map("variant_id")
  uomId               String? @map("uom_id")
  quantity            Decimal @db.Decimal(18, 4)
  unitCost            Decimal @map("unit_cost") @db.Decimal(18, 4)
  lineTotal           Decimal @map("line_total") @db.Decimal(18, 4)
  batchNumber         String? @map("batch_number")
  expiryDate          String? @map("expiry_date")
  manufacturingDate   String? @map("manufacturing_date")
  stockMovementId     String? @map("stock_movement_id")

  grn               GoodsReceiptNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  variant           ProductVariant?    @relation(fields: [variantId], references: [id])
  uom               UnitOfMeasure?     @relation(fields: [uomId], references: [id])

  @@index([grnId])
  @@map("goods_receipt_items")
}

model SupplierBill {
  id             String    @id
  businessId     String    @map("business_id")
  branchId       String?   @map("branch_id")
  supplierId     String    @map("supplier_id")
  grnId          String?   @unique @map("grn_id")
  billNumber     String    @map("bill_number")
  billDate       DateTime  @default(now()) @map("bill_date")
  dueDate        DateTime? @map("due_date")
  /// open | partial | paid | void
  status         String    @default("open")
  subtotal       Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 4)
  balance        Decimal   @default(0) @db.Decimal(18, 4)
  journalEntryId String?   @map("journal_entry_id")
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  grn         GoodsReceiptNote?           @relation(fields: [grnId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([businessId, billNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@index([supplierId])
  @@map("supplier_bills")
}

model SupplierPayment {
  id             String   @id
  businessId     String   @map("business_id")
  branchId       String?  @map("branch_id")
  supplierId     String   @map("supplier_id")
  paymentNumber  String   @map("payment_number")
  paymentDate    DateTime @default(now()) @map("payment_date")
  amount         Decimal  @db.Decimal(18, 4)
  /// cash | bank | transfer | cheque | other
  method         String   @default("bank")
  accountId      String?  @map("account_id")
  reference      String?
  notes          String?  @db.Text
  journalEntryId String?  @map("journal_entry_id")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  account     Account?                    @relation(fields: [accountId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([businessId, paymentNumber])
  @@index([businessId, supplierId])
  @@index([branchId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id        String  @id
  paymentId String  @map("payment_id")
  billId    String  @map("bill_id")
  amount    Decimal @db.Decimal(18, 4)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId], references: [id])

  @@index([paymentId])
  @@index([billId])
  @@map("supplier_payment_allocations")
}

// ─── Phase 4: Customers / Sales / POS / Reps ─────────────────────────────────

model Customer {
  id               String   @id
  businessId       String   @map("business_id")
  code             String?
  name             String
  contactPerson    String?  @map("contact_person")
  email            String?
  phone            String?
  addressLine1     String?  @map("address_line1")
  city             String?
  state            String?
  country          String?  @default("NG")
  taxId            String?  @map("tax_id")
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  /// null = unlimited credit; 0 = cash only
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(18, 2)
  /// Invoice-level discount applied to every purchase (null/0 = none)
  discountPercent  Decimal? @map("discount_percent") @db.Decimal(8, 4)
  /// retail | wholesale | distributor | walk_in
  customerType     String   @default("retail") @map("customer_type")
  notes            String?  @db.Text
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdById      String?  @map("created_by_id")
  updatedById      String?  @map("updated_by_id")

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  noteRows       CustomerNote[]
  invoices       SalesInvoice[]
  payments       CustomerPayment[]
  deliveries     DeliveryOrder[]
  journalEntries JournalEntry[]    @relation("JournalCustomer")

  @@unique([businessId, code])
  @@index([businessId, name])
  @@map("customers")
}

model CustomerNote {
  id          String   @id
  businessId  String   @map("business_id")
  customerId  String   @map("customer_id")
  body        String   @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_notes")
}

/// Commercial sales-rep profile only (commission / attribution).
/// Identity (name/phone/email), home branch, and login live on Employee (+ User).
/// Journal/sales attribution uses SalesRep.id; transaction branch comes from active session (X-Branch-Id), not employee.home branch.
model SalesRep {
  id                String   @id
  businessId        String   @map("business_id")
  /// HR employee this sales-rep role belongs to (1:1). Employee must exist first.
  employeeId        String   @unique @map("employee_id")
  code              String?
  commissionPercent Decimal  @default(0) @map("commission_percent") @db.Decimal(8, 4)
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdById       String?  @map("created_by_id")

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  invoices       SalesInvoice[]
  commissions    SalesCommission[]
  journalEntries JournalEntry[]    @relation("JournalSalesRep")

  @@unique([businessId, code])
  @@index([businessId, employeeId])
  @@map("sales_reps")
}

model SalesInvoice {
  id                 String    @id
  businessId         String    @map("business_id")
  customerId         String    @map("customer_id")
  /// Default fulfilment warehouse for lines that do not name their own
  warehouseId        String    @map("warehouse_id")
  /// Revenue branch: AR, revenue and COGS are booked here
  branchId           String?   @map("branch_id")
  /// Branch where the sale was made (pricing, rep, discounts); defaults to branchId
  sellingBranchId    String?   @map("selling_branch_id")
  salesRepId         String?   @map("sales_rep_id")
  invoiceNumber      String    @map("invoice_number")
  /// sales | pos
  channel            String    @default("sales")
  /// draft | posted | void
  status             String    @default("draft")
  /// immediate (handed over at posting) | pickup (collected later from the line warehouses)
  fulfilmentMode     String    @default("immediate") @map("fulfilment_mode")
  /// pending | partial | fulfilled
  fulfilmentStatus   String    @default("fulfilled") @map("fulfilment_status")
  /// at_fulfilment: revenue/AR per hand-over | on_posting: legacy, revenue booked when posted
  recognitionPolicy  String    @default("at_fulfilment") @map("recognition_policy")
  /// Revenue + tax recognised so far (the receivable raised)
  recognisedAmount   Decimal   @default(0) @map("recognised_amount") @db.Decimal(18, 4)
  /// Payments received but not yet applied to recognised value (customer deposit liability)
  depositHeld        Decimal   @default(0) @map("deposit_held") @db.Decimal(18, 4)
  /// Order value released by cancellation (never recognised)
  cancelledAmount    Decimal   @default(0) @map("cancelled_amount") @db.Decimal(18, 4)
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledById      String?   @map("cancelled_by_id")
  cancelReason       String?   @map("cancel_reason") @db.Text
  /// Credit limit override recorded at confirmation
  creditOverrideById String?   @map("credit_override_by_id")
  creditOverrideReason String? @map("credit_override_reason") @db.Text
  /// open | partial | paid | void
  paymentStatus      String    @default("open") @map("payment_status")
  invoiceDate        DateTime  @default(now()) @map("invoice_date")
  dueDate            DateTime? @map("due_date")
  notes              String?   @db.Text
  subtotal           Decimal   @default(0) @db.Decimal(18, 4)
  /// Customer discount % captured when the invoice was created
  discountPercent    Decimal?  @map("discount_percent") @db.Decimal(8, 4)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  amountPaid         Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 4)
  balance            Decimal   @default(0) @db.Decimal(18, 4)
  journalEntryId     String?   @map("journal_entry_id")
  cogsJournalEntryId String?   @map("cogs_journal_entry_id")
  postedAt           DateTime? @map("posted_at")
  postedById         String?   @map("posted_by_id")
  createdById        String?   @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer                    @relation(fields: [customerId], references: [id])
  warehouse   Warehouse                   @relation(fields: [warehouseId], references: [id])
  branch      Branch?                     @relation("InvoiceRevenueBranch", fields: [branchId], references: [id], onDelete: SetNull)
  sellingBranch Branch?                   @relation("InvoiceSellingBranch", fields: [sellingBranchId], references: [id], onDelete: SetNull)
  salesRep    SalesRep?                   @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  items       SalesInvoiceItem[]
  allocations CustomerPaymentAllocation[]
  commissions SalesCommission[]
  deliveries  DeliveryOrder[]
  fulfilments SalesFulfilment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@index([customerId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id              String  @id
  invoiceId       String  @map("invoice_id")
  productId       String  @map("product_id")
  variantId       String? @map("variant_id")
  uomId           String? @map("uom_id")
  quantity        Decimal @db.Decimal(18, 4)
  /// Net price charged (after any branch discount)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  /// List price before the branch discount (null when no discount applied)
  grossUnitPrice  Decimal? @map("gross_unit_price") @db.Decimal(18, 4)
  discountPercent Decimal? @map("discount_percent") @db.Decimal(8, 4)
  lineTotal       Decimal @map("line_total") @db.Decimal(18, 4)
  priceLevel      String? @map("price_level")
  stockMovementId String? @map("stock_movement_id")
  cogsAmount      Decimal @default(0) @map("cogs_amount") @db.Decimal(18, 4)
  /// Warehouse the goods are picked from (null = invoice warehouse)
  fulfilmentWarehouseId String?  @map("fulfilment_warehouse_id")
  /// Quantity handed over so far, in the line UoM
  fulfilledQuantity     Decimal  @default(0) @map("fulfilled_quantity") @db.Decimal(18, 4)
  /// Ordered quantity in the product base UoM (set at confirmation)
  baseQuantity          Decimal? @map("base_quantity") @db.Decimal(18, 4)
  /// Quantity cancelled (never to be fulfilled), in the line UoM
  cancelledQuantity     Decimal  @default(0) @map("cancelled_quantity") @db.Decimal(18, 4)
  /// Revenue + tax recognised for this line so far
  recognisedAmount      Decimal  @default(0) @map("recognised_amount") @db.Decimal(18, 4)
  /// Manual allocation chosen on the draft: [{ warehouse_id, quantity }] in the line UoM
  allocationPlan        Json?    @map("allocation_plan")

  invoice SalesInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  uom     UnitOfMeasure?  @relation(fields: [uomId], references: [id])
  fulfilmentWarehouse Warehouse? @relation(fields: [fulfilmentWarehouseId], references: [id])
  reservations        SalesReservation[]
  fulfilmentItems     SalesFulfilmentItem[]

  @@index([invoiceId])
  @@index([fulfilmentWarehouseId])
  @@map("sales_invoice_items")
}

/// Stock lots committed to a posted invoice line until it is collected.
model SalesReservation {
  id                String   @id
  businessId        String   @map("business_id")
  invoiceItemId     String   @map("invoice_item_id")
  lotId             String   @map("lot_id")
  warehouseId       String   @map("warehouse_id")
  /// Base-UoM quantity reserved
  quantity          Decimal  @db.Decimal(18, 4)
  fulfilledQuantity Decimal  @default(0) @map("fulfilled_quantity") @db.Decimal(18, 4)
  releasedQuantity  Decimal  @default(0) @map("released_quantity") @db.Decimal(18, 4)
  /// active | fulfilled | released
  status            String   @default("active")
  /// auto | manual | reallocation | backorder
  method            String   @default("auto")
  branchId          String?  @map("branch_id")
  createdById       String?  @map("created_by_id")
  releasedById      String?  @map("released_by_id")
  releasedAt        DateTime? @map("released_at")
  /// cancelled | expired | reallocated | discrepancy | manual
  releaseReason     String?  @map("release_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  lot         StockLot         @relation(fields: [lotId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])

  @@index([invoiceItemId])
  @@index([lotId, status])
  @@index([warehouseId, status])
  @@map("sales_reservations")
}

/// A hand-over of invoiced goods from one warehouse (pickup or immediate release).
model SalesFulfilment {
  id                String    @id
  businessId        String    @map("business_id")
  fulfilmentNumber  String    @map("fulfilment_number")
  invoiceId         String    @map("invoice_id")
  warehouseId       String    @map("warehouse_id")
  /// Branch of the fulfilling warehouse
  branchId          String    @map("branch_id")
  collectedBy       String?   @map("collected_by")
  collectorPhone    String?   @map("collector_phone")
  idReference       String?   @map("id_reference")
  notes             String?   @db.Text
  totalCost         Decimal   @default(0) @map("total_cost") @db.Decimal(18, 4)
  /// Revenue + tax recognised by this hand-over
  recognisedAmount  Decimal   @default(0) @map("recognised_amount") @db.Decimal(18, 4)
  /// Deposit applied against the receivable raised by this hand-over
  depositApplied    Decimal   @default(0) @map("deposit_applied") @db.Decimal(18, 4)
  /// Revenue / AR journal in the revenue branch
  revenueJournalEntryId    String? @map("revenue_journal_entry_id")
  /// COGS journal in the revenue branch
  cogsJournalEntryId       String? @map("cogs_journal_entry_id")
  /// Inventory relief journal in the fulfilling branch (only when it differs from the revenue branch)
  inventoryJournalEntryId  String? @map("inventory_journal_entry_id")
  fulfilledById     String?   @map("fulfilled_by_id")
  fulfilledAt       DateTime  @default(now()) @map("fulfilled_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice   SalesInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  branch    Branch                @relation(fields: [branchId], references: [id])
  items     SalesFulfilmentItem[]

  @@unique([businessId, fulfilmentNumber])
  @@index([invoiceId])
  @@map("sales_fulfilments")
}

model SalesFulfilmentItem {
  id            String  @id
  fulfilmentId  String  @map("fulfilment_id")
  invoiceItemId String  @map("invoice_item_id")
  /// Quantity in the invoice line UoM
  quantity      Decimal @db.Decimal(18, 4)
  baseQuantity  Decimal @map("base_quantity") @db.Decimal(18, 4)
  cost          Decimal @default(0) @db.Decimal(18, 4)
  recognisedAmount Decimal @default(0) @map("recognised_amount") @db.Decimal(18, 4)

  fulfilment  SalesFulfilment  @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@index([fulfilmentId])
  @@index([invoiceItemId])
  @@map("sales_fulfilment_items")
}

model CustomerPayment {
  id             String   @id
  businessId     String   @map("business_id")
  branchId       String?  @map("branch_id")
  customerId     String   @map("customer_id")
  paymentNumber  String   @map("payment_number")
  paymentDate    DateTime @default(now()) @map("payment_date")
  amount         Decimal  @db.Decimal(18, 4)
  /// cash | bank | transfer | cheque | other
  method         String   @default("cash")
  accountId      String?  @map("account_id")
  reference      String?
  notes          String?  @db.Text
  journalEntryId String?  @map("journal_entry_id")
  /// Part of the receipt not allocated to any invoice (customer credit in unapplied receipts)
  unappliedAmount Decimal @default(0) @map("unapplied_amount") @db.Decimal(18, 4)
  idempotencyKey String?  @map("idempotency_key")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer                    @relation(fields: [customerId], references: [id])
  account     Account?                    @relation(fields: [accountId], references: [id])
  allocations CustomerPaymentAllocation[]

  @@unique([businessId, paymentNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([branchId])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id        String  @id
  paymentId String  @map("payment_id")
  invoiceId String  @map("invoice_id")
  amount    Decimal @db.Decimal(18, 4)
  /// Portion that settled the recognised receivable when allocated
  arAmount      Decimal @default(0) @map("ar_amount") @db.Decimal(18, 4)
  /// Portion held as a customer deposit against unrecognised order value
  depositAmount Decimal @default(0) @map("deposit_amount") @db.Decimal(18, 4)
  /// Deposit later returned to unapplied customer credit (e.g. order cancelled)
  releasedAmount Decimal @default(0) @map("released_amount") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at")

  payment CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice    @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("customer_payment_allocations")
}

model SalesCommission {
  id                String   @id
  businessId        String   @map("business_id")
  branchId          String?  @map("branch_id")
  salesRepId        String   @map("sales_rep_id")
  invoiceId         String   @map("invoice_id")
  baseAmount        Decimal  @map("base_amount") @db.Decimal(18, 4)
  commissionPercent Decimal  @map("commission_percent") @db.Decimal(8, 4)
  commissionAmount  Decimal  @map("commission_amount") @db.Decimal(18, 4)
  /// accrued | paid | void
  status            String   @default("accrued")
  createdAt         DateTime @default(now()) @map("created_at")

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  salesRep SalesRep     @relation(fields: [salesRepId], references: [id])
  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, salesRepId])
  @@index([businessId, salesRepId])
  @@index([branchId])
  @@map("sales_commissions")
}

// ─── Phase 5: Banking / Expenses / Statements support ────────────────────────

model BankAccount {
  id             String   @id
  businessId     String   @map("business_id")
  branchId       String?  @map("branch_id")
  name           String
  bankName       String?  @map("bank_name")
  accountNumber  String?  @map("account_number")
  currencyCode   String   @default("NGN") @map("currency_code")
  glAccountId    String   @map("gl_account_id")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(18, 4)
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by_id")

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  glAccount    Account           @relation(fields: [glAccountId], references: [id])
  transactions BankTransaction[] @relation("BankTxnAccount")
  transfersIn  BankTransaction[] @relation("BankTxnCounterparty")
  expenseBills ExpenseBill[]

  @@index([businessId])
  @@index([branchId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                        String   @id
  businessId                String   @map("business_id")
  branchId                  String?  @map("branch_id")
  bankAccountId             String   @map("bank_account_id")
  txnNumber                 String   @map("txn_number")
  txnDate                   DateTime @default(now()) @map("txn_date")
  /// deposit | withdrawal | transfer
  type                      String
  amount                    Decimal  @db.Decimal(18, 4)
  counterpartyBankAccountId String?  @map("counterparty_bank_account_id")
  offsetAccountId           String?  @map("offset_account_id")
  memo                      String?  @db.Text
  reference                 String?
  journalEntryId            String?  @map("journal_entry_id")
  status                    String   @default("posted")
  createdById               String?  @map("created_by_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  business                Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                  Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bankAccount             BankAccount  @relation("BankTxnAccount", fields: [bankAccountId], references: [id])
  counterpartyBankAccount BankAccount? @relation("BankTxnCounterparty", fields: [counterpartyBankAccountId], references: [id])
  offsetAccount           Account?     @relation("BankTxnOffsetAccount", fields: [offsetAccountId], references: [id])

  @@unique([businessId, txnNumber])
  @@index([businessId, bankAccountId])
  @@index([branchId])
  @@map("bank_transactions")
}

model ExpenseBill {
  id                    String    @id
  businessId            String    @map("business_id")
  branchId              String?   @map("branch_id")
  expenseNumber         String    @map("expense_number")
  vendorName            String?   @map("vendor_name")
  supplierId            String?   @map("supplier_id")
  expenseDate           DateTime  @default(now()) @map("expense_date")
  dueDate               DateTime? @map("due_date")
  /// draft | posted | void
  status                String    @default("draft")
  /// open | partial | paid
  paymentStatus         String    @default("open") @map("payment_status")
  subtotal              Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount             Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount           Decimal   @default(0) @map("total_amount") @db.Decimal(18, 4)
  amountPaid            Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 4)
  balance               Decimal   @default(0) @db.Decimal(18, 4)
  /// cash | bank | ap
  payMethod             String?   @map("pay_method")
  bankAccountId         String?   @map("bank_account_id")
  journalEntryId        String?   @map("journal_entry_id")
  paymentJournalEntryId String?   @map("payment_journal_entry_id")
  notes                 String?   @db.Text
  createdById           String?   @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  lines       ExpenseBillLine[]

  @@unique([businessId, expenseNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@map("expense_bills")
}

model ExpenseBillLine {
  id          String  @id
  expenseId   String  @map("expense_id")
  accountId   String  @map("account_id")
  description String?
  amount      Decimal @db.Decimal(18, 4)

  expense ExpenseBill @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  account Account     @relation(fields: [accountId], references: [id])

  @@index([expenseId])
  @@map("expense_bill_lines")
}

// --- Phase 6: Assets / Depreciation / Budgeting ------------------------------

model FixedAsset {
  id                        String   @id
  businessId                String   @map("business_id")
  branchId                  String?  @map("branch_id")
  code                      String?
  name                      String
  category                  String   @default("equipment")
  purchaseDate              DateTime @map("purchase_date")
  purchaseCost              Decimal  @map("purchase_cost") @db.Decimal(18, 4)
  salvageValue              Decimal  @default(0) @map("salvage_value") @db.Decimal(18, 4)
  usefulLifeMonths          Int      @default(36) @map("useful_life_months")
  /// straight_line
  depreciationMethod        String   @default("straight_line") @map("depreciation_method")
  accumulatedDepreciation   Decimal  @default(0) @map("accumulated_depreciation") @db.Decimal(18, 4)
  /// active | fully_depreciated | disposed
  status                    String   @default("active")
  notes                     String?  @db.Text
  acquisitionJournalEntryId String?  @map("acquisition_journal_entry_id")
  createdById               String?  @map("created_by_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  depreciationEntries DepreciationEntry[]

  @@unique([businessId, code])
  @@index([businessId, status])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id             String   @id
  businessId     String   @map("business_id")
  assetId        String   @map("asset_id")
  periodLabel    String   @map("period_label")
  runDate        DateTime @default(now()) @map("run_date")
  amount         Decimal  @db.Decimal(18, 4)
  journalEntryId String?  @map("journal_entry_id")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, periodLabel])
  @@index([businessId])
  @@map("depreciation_entries")
}

model Budget {
  id          String   @id
  businessId  String   @map("business_id")
  branchId    String?  @map("branch_id")
  name        String
  fiscalYear  Int      @map("fiscal_year")
  /// draft | active | closed
  status      String   @default("draft")
  notes       String?  @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines    BudgetLine[]

  @@index([businessId, fiscalYear])
  @@index([branchId])
  @@map("budgets")
}

model BudgetLine {
  id        String  @id
  budgetId  String  @map("budget_id")
  accountId String  @map("account_id")
  /// 0 = annual total; 1-12 = month
  periodNo  Int     @default(0) @map("period_no")
  amount    Decimal @db.Decimal(18, 4)

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId, periodNo])
  @@index([budgetId])
  @@map("budget_lines")
}

// --- Phase 7: HR / Attendance / Payroll --------------------------------------

model Employee {
  id           String   @id
  businessId   String   @map("business_id")
  /// Home / HR branch. Transaction branch for postings is session active branch, not this field.
  branchId     String   @map("branch_id")
  /// Login account for this employee (required).
  userId       String   @unique @map("user_id")
  code         String?
  fullName     String   @map("full_name")
  email        String?
  phone        String?
  department   String?
  jobTitle     String?  @map("job_title")
  hireDate     DateTime? @map("hire_date")
  baseSalary   Decimal  @default(0) @map("base_salary") @db.Decimal(18, 4)
  /// monthly | biweekly | weekly
  payFrequency String   @default("monthly") @map("pay_frequency")
  bankName     String?  @map("bank_name")
  bankAccount  String?  @map("bank_account")
  taxId        String?  @map("tax_id")
  pensionId    String?  @map("pension_id")
  status       String   @default("active")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  salesRep       SalesRep?
  attendance     AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  payrollItems   PayrollItem[]
  vehiclesDriven Vehicle[]

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, branchId])
  @@map("employees")
}

model AttendanceRecord {
  id         String    @id
  businessId String    @map("business_id")
  employeeId String    @map("employee_id")
  workDate   DateTime  @map("work_date")
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")
  /// present | absent | leave | half_day
  status     String    @default("present")
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([businessId, workDate])
  @@map("attendance_records")
}

model LeaveRequest {
  id           String   @id
  businessId   String   @map("business_id")
  employeeId   String   @map("employee_id")
  leaveType    String   @default("annual") @map("leave_type")
  startsOn     DateTime @map("starts_on")
  endsOn       DateTime @map("ends_on")
  days         Decimal  @default(1) @db.Decimal(8, 2)
  reason       String?  @db.Text
  /// pending | approved | rejected | cancelled
  status       String   @default("pending")
  approvedById String?  @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("leave_requests")
}

model PayrollRun {
  id                    String   @id
  businessId            String   @map("business_id")
  branchId              String?  @map("branch_id")
  runNumber             String   @map("run_number")
  periodStart           DateTime @map("period_start")
  periodEnd             DateTime @map("period_end")
  payDate               DateTime @map("pay_date")
  /// draft | posted | void
  status                String   @default("draft")
  totalGross            Decimal  @default(0) @map("total_gross") @db.Decimal(18, 4)
  totalDeductions       Decimal  @default(0) @map("total_deductions") @db.Decimal(18, 4)
  totalNet              Decimal  @default(0) @map("total_net") @db.Decimal(18, 4)
  journalEntryId        String?  @map("journal_entry_id")
  paymentJournalEntryId String?  @map("payment_journal_entry_id")
  notes                 String?  @db.Text
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items    PayrollItem[]

  @@unique([businessId, runNumber])
  @@index([businessId, status])
  @@index([branchId])
  @@map("payroll_runs")
}

model PayrollItem {
  id              String  @id
  payrollRunId    String  @map("payroll_run_id")
  employeeId      String  @map("employee_id")
  basicSalary     Decimal @map("basic_salary") @db.Decimal(18, 4)
  allowances      Decimal @default(0) @db.Decimal(18, 4)
  deductions      Decimal @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  pensionEmployee Decimal @default(0) @map("pension_employee") @db.Decimal(18, 4)
  pensionEmployer Decimal @default(0) @map("pension_employer") @db.Decimal(18, 4)
  netPay          Decimal @map("net_pay") @db.Decimal(18, 4)
  notes           String? @db.Text

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_items")
}

// --- Phase 8: Distribution / Logistics / Delivery ----------------------------

model Vehicle {
  id               String   @id
  businessId       String   @map("business_id")
  code             String?
  name             String
  plateNumber      String?  @map("plate_number")
  capacity         Decimal? @db.Decimal(18, 2)
  driverEmployeeId String?  @map("driver_employee_id")
  status           String   @default("available")
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  driver     Employee?       @relation(fields: [driverEmployeeId], references: [id], onDelete: SetNull)
  deliveries DeliveryOrder[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("vehicles")
}

model DeliveryOrder {
  id             String    @id
  businessId     String    @map("business_id")
  deliveryNumber String    @map("delivery_number")
  salesInvoiceId String?   @map("sales_invoice_id")
  customerId     String    @map("customer_id")
  warehouseId    String    @map("warehouse_id")
  branchId       String?   @map("branch_id")
  vehicleId      String?   @map("vehicle_id")
  driverName     String?   @map("driver_name")
  scheduledDate  DateTime? @map("scheduled_date")
  dispatchedAt   DateTime? @map("dispatched_at")
  deliveredAt    DateTime? @map("delivered_at")
  /// draft | scheduled | dispatched | delivered | cancelled
  status         String    @default("draft")
  addressLine1   String?   @map("address_line1")
  city           String?
  notes          String?   @db.Text
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice?       @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  customer     Customer            @relation(fields: [customerId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  items        DeliveryOrderItem[]

  @@unique([businessId, deliveryNumber])
  @@index([businessId, status])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id              String  @id
  deliveryOrderId String  @map("delivery_order_id")
  productId       String  @map("product_id")
  variantId       String? @map("variant_id")
  quantity        Decimal @db.Decimal(18, 4)
  notes           String? @db.Text

  deliveryOrder DeliveryOrder   @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([deliveryOrderId])
  @@map("delivery_order_items")
}

// --- Phase 9: Notifications (BI/SaaS reuse existing tables) -------------------

model AppNotification {
  id         String   @id
  businessId String   @map("business_id")
  userId     String?  @map("user_id")
  title      String
  body       String   @db.Text
  module     String?
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, isRead])
  @@index([createdAt])
  @@map("app_notifications")
}
